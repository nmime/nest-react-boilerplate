import /etc/caddy/common.caddy

{$PUBLIC_DOMAIN} {
	import common_server

	@auth_callbacks path /auth/discord/callback
	handle @auth_callbacks {
		reverse_proxy auth-app-api:80
	}

	@oauth_api path /oauth /oauth/*
	handle @oauth_api {
		reverse_proxy auth-app-api:80
	}

	import core_same_origin_api_routes
	import /etc/caddy/routes/optional/{$EDGE_OPTIONAL_ROUTES:default}.caddy

	handle {
		reverse_proxy {$PRIMARY_APP_UPSTREAM}
	}

	import /etc/caddy/tls/{$EDGE_TLS_MODE:automatic}.caddy
}
