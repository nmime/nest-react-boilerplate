{
  "name": "@repo/tooling",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Reusable TS-first repo tooling commands for API contracts, database operations, Docker, testing, QA presets, and repository checks.",
  "bin": {
    "repo-tooling": "./bin/repo-tooling.mjs",
    "nrb": "./bin/repo-tooling.mjs"
  },
  "scripts": {
    "tooling": "node ./bin/repo-tooling.mjs",
    "test": "node ./scripts/run-tests.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "static-check": "node --max-old-space-size=1024 ./bin/repo-tooling.mjs tooling static-check",
    "check": "pnpm run typecheck && pnpm run static-check"
  },
  "files": [
    "bin",
    "src",
    "config",
    "baselines",
    "README.md",
    "tsconfig.json"
  ],
  "dependencies": {
    "@mikro-orm/core": "7.2.2",
    "@nestjs/common": "12.1.1",
    "@nestjs/core": "12.1.1",
    "@nestjs/platform-fastify": "12.1.1",
    "@nx/devkit": "23.2.1",
    "@playwright/test": "1.63.0",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.16.12",
    "@testcontainers/postgresql": "12.2.0",
    "@types/istanbul-lib-coverage": "2.0.6",
    "@types/istanbul-lib-report": "3.0.3",
    "@types/istanbul-reports": "3.0.4",
    "ajv": "8.20.0",
    "axe-core": "4.13.0",
    "fast-check": "4.10.2",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-report": "3.0.1",
    "istanbul-reports": "3.2.0",
    "jiti": "2.7.0",
    "mongodb": "7.7.0",
    "mongodb-connection-string-url": "7.0.2",
    "pg": "8.23.0",
    "sharp": "0.35.5",
    "tsconfig-paths": "4.2.0",
    "yaml": "2.9.1",
    "zod": "^4.6.5"
  },
  "generators": "./generators.json",
  "exports": {
    ".": "./src/cli.ts",
    "./commands/*": "./src/commands/*.ts",
    "./runtime/*": "./src/runtime/*.ts",
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0",
    "@testcontainers/mongodb": "12.2.0",
    "@types/node": "24.19.0",
    "nx": "23.2.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
