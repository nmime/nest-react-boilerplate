{
  "name": "@app/backend-feature-notification",
  "$schema": "../../../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/backend/feature/notification/lib/src",
  "projectType": "library",
  "tags": ["platform:backend", "type:feature-main", "scope:notification"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/backend/feature/notification/lib",
        "main": "libs/backend/feature/notification/lib/src/index.ts",
        "tsConfig": "libs/backend/feature/notification/lib/tsconfig.lib.json",
        "assets": [],
        "rootDir": "."
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": { "cwd": "libs/backend/feature/notification/lib", "command": "NODE_ENV=test vitest run --config vitest.config.mts" },
      "inputs": ["default", "^production", {"externalDependencies": ["vitest"]}],
      "outputs": ["{workspaceRoot}/coverage/libs/backend/feature/notification/lib"]
    }
  }
}
