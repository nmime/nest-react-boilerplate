{
  "$schema": "https://json-schema.org/schema",
  "cli": "nx",
  "$id": "@repo/tooling/setup",
  "title": "Setup",
  "description": "Configure a repeatable application and capability selection",
  "type": "object",
  "properties": {
    "preset": {
      "type": "string",
      "description": "Preset configuration to apply",
      "enum": ["minimal", "web", "fullstack", "enterprise", "bots"],
      "x-priority": "important"
    },
    "apps": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "admin-app",
          "user-app",
          "landing-app",
          "site-app",
          "mobile-app",
          "admin-app-api",
          "user-app-api",
          "auth-app-api",
          "discord-app-api",
          "telegram-bot-api",
          "notification-consumer",
          "notification-scheduler",
          "fullstack-e2e",
          "acceptance-e2e"
        ]
      },
      "description": "Applications to add to the current selection",
      "default": [],
      "x-priority": "important"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "i18n",
          "analytics",
          "websockets",
          "feature-flags",
          "notifications",
          "design-tokens",
          "authz",
          "postgres",
          "mongodb",
          "redis",
          "s3",
          "static-data",
          "nats",
          "otel",
          "swagger",
          "telegram-bot",
          "discord-bot",
          "tenancy"
        ]
      },
      "description": "Capabilities to add to the current selection",
      "default": [],
      "x-priority": "important"
    },
    "removeApps": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "admin-app",
          "user-app",
          "landing-app",
          "site-app",
          "mobile-app",
          "admin-app-api",
          "user-app-api",
          "auth-app-api",
          "discord-app-api",
          "telegram-bot-api",
          "notification-consumer",
          "notification-scheduler",
          "fullstack-e2e",
          "acceptance-e2e"
        ]
      },
      "description": "Applications to remove when no selected application requires them",
      "default": []
    },
    "removeCapabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "i18n",
          "analytics",
          "websockets",
          "feature-flags",
          "notifications",
          "design-tokens",
          "authz",
          "postgres",
          "mongodb",
          "redis",
          "s3",
          "static-data",
          "nats",
          "otel",
          "swagger",
          "telegram-bot",
          "discord-bot",
          "tenancy"
        ]
      },
      "description": "Capabilities to remove when no selected application or capability requires them",
      "default": []
    },
    "replace": {
      "type": "boolean",
      "description": "Replace the current selection instead of adding to it",
      "default": false
    },
    "ciMode": { "type": "string", "enum": ["product", "maintainer"] },
    "frontendApiMode": { "type": "string", "enum": ["same-origin", "split-origin"] },
    "mobileTargets": {
      "type": "array",
      "items": { "type": "string", "enum": ["web", "android", "ios"] }
    },
    "deploymentTargets": {
      "type": "array",
      "items": { "type": "string", "enum": ["docker", "single-server", "kubernetes"] }
    },
    "publicTopology": {
      "type": "string",
      "enum": ["single-domain", "per-app-domains", "external-proxy"]
    },
    "kubernetesDelivery": { "type": "string", "enum": ["direct", "argocd", "flux"] },
    "redisOwnership": { "type": "string", "enum": ["bundled", "external"] },
    "natsOwnership": { "type": "string", "enum": ["bundled", "external"] },
    "s3Ownership": { "type": "string", "enum": ["bundled", "external"] },
    "prune": {
      "type": "boolean",
      "description": "Remove files no longer needed after config change",
      "default": false
    },
    "force": {
      "type": "boolean",
      "description": "Force overwrite generated files without conflict check",
      "default": false
    },
    "dryRun": {
      "type": "boolean",
      "description": "Output the plan as JSON instead of executing",
      "default": false
    }
  },
  "required": []
}
