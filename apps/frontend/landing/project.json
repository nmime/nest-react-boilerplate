{
  "name": "landing-app",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/frontend/landing/src",
  "projectType": "application",
  "tags": ["platform:frontend", "type:frontend-app", "scope:landing", "fsd:layer:app"],
  "// targets": "to see all targets run: nx show project landing-app --web",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/frontend/landing",
        "command": "node_modules/.bin/astro dev --host localhost --port 4202"
      },
      "inputs": [
        "default",
        {
          "externalDependencies": ["astro", "@astrojs/react", "@astrojs/mdx", "@astrojs/sitemap"]
        }
      ]
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "apps/frontend/landing",
        "command": "VITE_API_BASE_URL_MODE=same-origin node_modules/.bin/astro build"
      },
      "inputs": [
        "production",
        {
          "externalDependencies": ["astro", "@astrojs/react", "@astrojs/mdx", "@astrojs/sitemap"]
        }
      ],
      "outputs": ["{workspaceRoot}/dist/apps/frontend/landing"]
    },
    "preview": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "cwd": "apps/frontend/landing",
        "command": "node_modules/.bin/astro preview --host localhost --port 4202"
      },
      "inputs": [
        "production",
        {
          "externalDependencies": ["astro", "@astrojs/react", "@astrojs/mdx", "@astrojs/sitemap"]
        }
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "apps/frontend/landing",
        "command": "NODE_ENV=test vitest run --config vitest.config.mts"
      },
      "inputs": [
        "default",
        "^production",
        {
          "externalDependencies": ["vitest"]
        }
      ],
      "outputs": ["{workspaceRoot}/coverage/apps/frontend/landing"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "apps/frontend/landing",
        "command": "node_modules/.bin/astro check"
      },
      "inputs": [
        "default",
        "^production",
        {
          "externalDependencies": ["astro", "@astrojs/check", "typescript"]
        }
      ]
    },
    "e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "cwd": "apps/frontend/landing",
        "command": "node scripts/smoke-astro-build.mjs"
      },
      "inputs": [
        "production",
        {
          "externalDependencies": ["astro", "@astrojs/react", "@astrojs/mdx", "@astrojs/sitemap"]
        }
      ],
      "outputs": ["{workspaceRoot}/dist/apps/frontend/landing"]
    }
  }
}
