{
  "name": "@app/backend-common-tenant-context",
  "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/backend/common/tenant-context/lib/src",
  "projectType": "library",
  "tags": ["platform:backend", "type:common", "scope:shared", "boundary:backend-kernel"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/backend/common/tenant-context/lib",
        "main": "libs/backend/common/tenant-context/lib/src/index.ts",
        "tsConfig": "libs/backend/common/tenant-context/lib/tsconfig.lib.json",
        "assets": [],
        "rootDir": "."
      },
      "inputs": [
        "production",
        "^production",
        {
          "externalDependencies": ["@nestjs/common", "@nestjs/core", "rxjs"]
        }
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "libs/backend/common/tenant-context/lib",
        "command": "vitest run --config vitest.config.mts"
      },
      "inputs": [
        "default",
        "^production",
        {
          "externalDependencies": ["vitest"]
        }
      ],
      "outputs": ["{workspaceRoot}/coverage/libs/backend/common/tenant-context/lib"]
    }
  }
}
