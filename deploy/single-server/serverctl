#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'
umask 027

readonly CONTROLLER_NAME='nrb-server'
readonly DEFAULT_CONFIG_ROOT='/etc/nest-react-boilerplate'
SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
readonly SCRIPT_PATH
SCRIPT_DIR="$(cd -- "$(dirname -- "${SCRIPT_PATH}")" && pwd -P)"
readonly SCRIPT_DIR
SOURCE_ROOT="$(cd -- "${SCRIPT_DIR}/../.." && pwd -P)"
readonly SOURCE_ROOT

CONFIG_ROOT="${NRB_CONFIG_ROOT:-${DEFAULT_CONFIG_ROOT}}"
SERVER_ENV="${CONFIG_ROOT}/server.env"
PRODUCTION_ENV="${CONFIG_ROOT}/.env.production"
COMMAND="${1:-help}"
shift || true

SYSTEM_UPDATE=false
ASSUME_YES=false
IMAGE_TAG_OVERRIDE=''
LOG_SERVICE=''

log() { printf '[%s] %s\n' "${CONTROLLER_NAME}" "$*" >&2; }
die() { log "ERROR: $*"; exit 1; }

usage() {
  cat <<'USAGE'
Usage: sudo nrb-server <command> [options]

Commands:
  init                 Create protected configuration and core secrets once.
  provision            Idempotently install/upgrade host prerequisites.
  apply                Provision, validate, deploy, obtain TLS, and verify.
  deploy               Validate and converge the runtime, TLS, and Nginx.
  update               Fast-forward code and redeploy.
  rollback             Redeploy the previously successful immutable image tag.
  renew                Renew due certificates and reload Nginx.
  doctor               Validate configuration, DNS, services, TLS, and binds.
  status               Show runtime versions, units, processes, and TLS dates.
  logs [service]       Follow production logs (optionally one service).

Runtimes (server.env RUNTIME_MODE):
  compose              Docker Compose images under systemd. Image provenance comes
                       from COMPOSE_IMAGE_SOURCE in .env.production: "registry"
                       pulls immutable sha-<git-sha> tags, "local" builds them here.
  native              PM2-supervised Node processes, host PostgreSQL/Redis, and the
                       built SPAs served from disk. No Docker at all.

Options:
  --image-tag sha-...  Immutable image tag for update (compose + registry only).
  --system             Also rerun provision during update.
  --yes                Confirm the database-compatible rollback warning.

Environment:
  NRB_CONFIG_ROOT      Override /etc/nest-react-boilerplate.
USAGE
}

while (($#)); do
  case "$1" in
    --image-tag)
      (($# >= 2)) || die '--image-tag requires a value'
      IMAGE_TAG_OVERRIDE="$2"
      shift 2
      ;;
    --image-tag=*) IMAGE_TAG_OVERRIDE="${1#*=}"; shift ;;
    --system) SYSTEM_UPDATE=true; shift ;;
    --yes) ASSUME_YES=true; shift ;;
    --*) die "unknown option: $1" ;;
    *)
      [[ "${COMMAND}" == 'logs' && -z "${LOG_SERVICE}" ]] || die "unexpected argument: $1"
      LOG_SERVICE="$1"
      shift
      ;;
  esac
done

require_root() {
  [[ "${EUID}" -eq 0 ]] || die 'this command must run as root (use sudo)'
}

require_command() { command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"; }

validate_absolute_path() {
  local name="$1" value="$2"
  [[ "${value}" =~ ^/[A-Za-z0-9._/-]+$ ]] || die "${name} must be an absolute path without spaces: ${value}"
}

validate_dedicated_path() {
  local name="$1" value="$2"
  validate_absolute_path "${name}" "${value}"
  case "${value}" in
    /|/bin|/etc|/home|/opt|/root|/srv|/usr|/var|/var/lib)
      die "${name} must be a dedicated subdirectory, not ${value}"
      ;;
  esac
}

require_protected_regular_file() {
  local path="$1" label="$2" mode owner
  [[ -f "${path}" && ! -L "${path}" ]] || die "${label} must be a regular non-symlink file: ${path}"
  owner="$(stat -c '%U' "${path}")"
  [[ "${owner}" == 'root' ]] || die "${label} must be owned by root (got ${owner})"
  mode="$(stat -c '%a' "${path}")"
  (( (8#${mode} & 0022) == 0 )) || die "${label} must not be writable by group or other users (got ${mode})"
}

environment_value() {
  local key="$1" file="${2:-${PRODUCTION_ENV}}"
  awk -v key="${key}" '
    $0 ~ "^[[:space:]]*" key "=" {
      sub("^[[:space:]]*" key "=", "");
      gsub(/^[[:space:]]+|[[:space:]]+$/, "");
      gsub(/^\047|\047$/, "");
      gsub(/^\042|\042$/, "");
      print;
      exit;
    }
  ' "${file}"
}

load_server_environment() {
  [[ -f "${SERVER_ENV}" ]] || die "missing ${SERVER_ENV}; run '${CONTROLLER_NAME} init' first"
  require_protected_regular_file "${SERVER_ENV}" 'server environment'

  NODE_VERSION="$(environment_value NODE_VERSION "${SERVER_ENV}")"
  PNPM_VERSION="$(environment_value PNPM_VERSION "${SERVER_ENV}")"
  COREPACK_VERSION="$(environment_value COREPACK_VERSION "${SERVER_ENV}")"
  PM2_VERSION="$(environment_value PM2_VERSION "${SERVER_ENV}")"
  RUNTIME_MODE="$(environment_value RUNTIME_MODE "${SERVER_ENV}")"
  DEPLOY_USER="$(environment_value DEPLOY_USER "${SERVER_ENV}")"
  APP_ROOT="$(environment_value APP_ROOT "${SERVER_ENV}")"
  STATE_ROOT="$(environment_value STATE_ROOT "${SERVER_ENV}")"
  REPOSITORY_URL="$(environment_value REPOSITORY_URL "${SERVER_ENV}")"
  REPOSITORY_BRANCH="$(environment_value REPOSITORY_BRANCH "${SERVER_ENV}")"
  CERTIFICATE_MODE="$(environment_value CERTIFICATE_MODE "${SERVER_ENV}")"
  CERTIFICATE_NAME="$(environment_value CERTIFICATE_NAME "${SERVER_ENV}")"
  CERTBOT_EMAIL="$(environment_value CERTBOT_EMAIL "${SERVER_ENV}")"
  CERTBOT_DNS_PLUGIN="$(environment_value CERTBOT_DNS_PLUGIN "${SERVER_ENV}")"
  CERTBOT_DNS_PACKAGE="$(environment_value CERTBOT_DNS_PACKAGE "${SERVER_ENV}")"
  CERTBOT_DNS_CREDENTIALS="$(environment_value CERTBOT_DNS_CREDENTIALS "${SERVER_ENV}")"
  CERTBOT_DNS_PROPAGATION_SECONDS="$(environment_value CERTBOT_DNS_PROPAGATION_SECONDS "${SERVER_ENV}")"
  ENABLE_UFW="$(environment_value ENABLE_UFW "${SERVER_ENV}")"
  SSH_PORT="$(environment_value SSH_PORT "${SERVER_ENV}")"
  ENABLE_UNATTENDED_UPGRADES="$(environment_value ENABLE_UNATTENDED_UPGRADES "${SERVER_ENV}")"
  HEALTHCHECK_RETRIES="$(environment_value HEALTHCHECK_RETRIES "${SERVER_ENV}")"
  HEALTHCHECK_INTERVAL_SECONDS="$(environment_value HEALTHCHECK_INTERVAL_SECONDS "${SERVER_ENV}")"

  : "${NODE_VERSION:?NODE_VERSION is required in ${SERVER_ENV}}"
  : "${PNPM_VERSION:?PNPM_VERSION is required in ${SERVER_ENV}}"
  : "${DEPLOY_USER:?DEPLOY_USER is required in ${SERVER_ENV}}"
  : "${APP_ROOT:?APP_ROOT is required in ${SERVER_ENV}}"
  : "${CONFIG_ROOT:=${DEFAULT_CONFIG_ROOT}}"
  : "${STATE_ROOT:?STATE_ROOT is required in ${SERVER_ENV}}"
  : "${REPOSITORY_URL:?REPOSITORY_URL is required in ${SERVER_ENV}}"
  : "${REPOSITORY_BRANCH:=main}"
  : "${COREPACK_VERSION:=0.35.0}"
  : "${PM2_VERSION:=6.0.13}"
  # Hosts provisioned before the runtime axis existed keep their Compose behaviour.
  : "${RUNTIME_MODE:=compose}"
  : "${ENABLE_UFW:=false}"
  : "${ENABLE_UNATTENDED_UPGRADES:=true}"
  : "${SSH_PORT:=22}"
  : "${HEALTHCHECK_RETRIES:=30}"
  : "${HEALTHCHECK_INTERVAL_SECONDS:=2}"

  validate_dedicated_path APP_ROOT "${APP_ROOT}"
  validate_dedicated_path CONFIG_ROOT "${CONFIG_ROOT}"
  validate_dedicated_path STATE_ROOT "${STATE_ROOT}"
  [[ "${DEPLOY_USER}" =~ ^[a-z_][a-z0-9_-]*$ ]] || die 'DEPLOY_USER is invalid'
  [[ "${NODE_VERSION}" =~ ^24\.[0-9]+\.[0-9]+$ ]] || die 'NODE_VERSION must be an exact Node.js 24 release'
  [[ "${PNPM_VERSION}" =~ ^11\.[0-9]+\.[0-9]+$ ]] || die 'PNPM_VERSION must be an exact pnpm 11 release'
  [[ "${COREPACK_VERSION}" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die 'COREPACK_VERSION must be exact'
  [[ "${PM2_VERSION}" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die 'PM2_VERSION must be exact'
  [[ "${RUNTIME_MODE}" == 'compose' || "${RUNTIME_MODE}" == 'native' ]] || die 'RUNTIME_MODE must be compose or native'
  # Image provenance lives with the rest of the Compose wiring, so there is exactly
  # one source of truth for it and no second key to drift from.
  IMAGE_SOURCE=''
  [[ ! -f "${PRODUCTION_ENV}" ]] || IMAGE_SOURCE="$(environment_value COMPOSE_IMAGE_SOURCE "${PRODUCTION_ENV}")"
  : "${IMAGE_SOURCE:=registry}"
  [[ "${IMAGE_SOURCE}" == 'registry' || "${IMAGE_SOURCE}" == 'local' ]] || \
    die 'COMPOSE_IMAGE_SOURCE must be registry or local'
  if [[ "${RUNTIME_MODE}" == 'native' ]]; then
    [[ "${IMAGE_SOURCE}" == 'registry' ]] || die 'RUNTIME_MODE=native builds no images; unset COMPOSE_IMAGE_SOURCE'
    [[ -z "${IMAGE_TAG_OVERRIDE}" ]] || die 'RUNTIME_MODE=native has no image tags; --image-tag is not applicable'
  fi
  [[ "${REPOSITORY_BRANCH}" =~ ^[A-Za-z0-9][A-Za-z0-9._/-]*$ ]] || die 'REPOSITORY_BRANCH is invalid'
  [[ "${ENABLE_UFW}" == 'true' || "${ENABLE_UFW}" == 'false' ]] || die 'ENABLE_UFW must be true or false'
  [[ "${ENABLE_UNATTENDED_UPGRADES}" == 'true' || "${ENABLE_UNATTENDED_UPGRADES}" == 'false' ]] || die 'ENABLE_UNATTENDED_UPGRADES must be true or false'
  [[ "${SSH_PORT}" =~ ^[0-9]+$ && "${SSH_PORT}" -ge 1 && "${SSH_PORT}" -le 65535 ]] || die 'SSH_PORT must be from 1 through 65535'
  [[ "${HEALTHCHECK_RETRIES}" =~ ^[1-9][0-9]*$ ]] || die 'HEALTHCHECK_RETRIES must be positive'
  [[ "${HEALTHCHECK_INTERVAL_SECONDS}" =~ ^[1-9][0-9]*$ ]] || die 'HEALTHCHECK_INTERVAL_SECONDS must be positive'
}

with_lock() {
  mkdir -p /run/lock
  exec 9>/run/lock/nest-react-boilerplate.lock
  flock -n 9 || die 'another nest-react-boilerplate server operation is running'
}

run_as_deploy() {
  local home
  home="$(getent passwd "${DEPLOY_USER}" | cut -d: -f6)"
  validate_absolute_path DEPLOY_USER_HOME "${home}"
  runuser -u "${DEPLOY_USER}" -- env -i \
    HOME="${home}" USER="${DEPLOY_USER}" LOGNAME="${DEPLOY_USER}" \
    PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin' \
    "$@"
}

upsert_environment_value() {
  local file="$1" key="$2" value="$3" temporary
  temporary="$(mktemp "${file}.XXXXXX")"
  awk -v key="${key}" -v value="${value}" '
    BEGIN { found = 0 }
    $0 ~ "^[[:space:]]*" key "=" { print key "=" value; found = 1; next }
    { print }
    END { if (!found) print key "=" value }
  ' "${file}" >"${temporary}"
  chmod --reference="${file}" "${temporary}"
  chown --reference="${file}" "${temporary}"
  mv -f "${temporary}" "${file}"
}

create_secret() {
  local path="$1" generator="$2"
  if [[ -e "${path}" ]]; then
    require_protected_regular_file "${path}" 'secret'
    if [[ "${generator}" == 'empty' || -s "${path}" ]]; then
      return
    fi
  fi
  local temporary replacing=false
  [[ ! -e "${path}" ]] || replacing=true
  temporary="$(mktemp "${path}.XXXXXX")"
  case "${generator}" in
    hex) openssl rand -hex 32 >"${temporary}" ;;
    base64-32) openssl rand -base64 32 | tr -d '\n' >"${temporary}"; printf '\n' >>"${temporary}" ;;
    base64) openssl rand -base64 48 | tr -d '\n' >"${temporary}"; printf '\n' >>"${temporary}" ;;
    empty) : >"${temporary}" ;;
    *) die "unknown secret generator: ${generator}" ;;
  esac
  if [[ "${replacing}" == 'true' ]]; then
    chmod --reference="${path}" "${temporary}"
    chown --reference="${path}" "${temporary}"
  else
    chmod 600 "${temporary}"
  fi
  mv "${temporary}" "${path}"
}

configure_secret() {
  local key="$1" filename="$2" generator="$3" configured path
  configured="$(environment_value "${key}")"
  path="${CONFIG_ROOT}/secrets/${filename}"
  case "${configured}" in
    ''|./secrets/*) upsert_environment_value "${PRODUCTION_ENV}" "${key}" "${path}" ;;
    /*) path="${configured}" ;;
    *) die "${key} must be an absolute path or a template ./secrets path" ;;
  esac
  create_secret "${path}" "${generator}"
}

ensure_secret_material() {
  require_command openssl
  configure_secret SESSION_SECRET_FILE session_secret.txt hex
  configure_secret BETTER_AUTH_SECRET_FILE better_auth_secret.txt base64
  configure_secret AUTH_PROVIDER_TOKEN_ENCRYPTION_KEY_FILE auth_provider_token_encryption_key.txt base64-32
  configure_secret NOTIFICATION_PAYLOAD_ENCRYPTION_KEY_FILE notification_payload_encryption_key.txt base64-32
  configure_secret REDIS_PASSWORD_FILE redis_password.txt hex
  configure_secret GRAFANA_ADMIN_PASSWORD_FILE grafana_admin_password.txt base64
  local database_engine database_mode
  database_engine="$(environment_value DATABASE_ENGINE)"
  database_engine="${database_engine:-postgres}"
  database_mode="$(environment_value COMPOSE_DATABASE_MODE)"
  case "${database_engine}/${database_mode}" in
    postgres/bundled-db|postgres/native)
      configure_secret POSTGRES_PASSWORD_FILE postgres_password.txt base64
      ;;
    postgres/external-db)
      configure_secret DATABASE_URL_FILE database_url.txt empty
      ;;
    mongodb/bundled-db)
      upsert_environment_value "${PRODUCTION_ENV}" MONGODB_DATABASE_TOOLS_DOCKER_NETWORK nest-react-boilerplate_database
      configure_secret MONGODB_ROOT_PASSWORD_FILE mongodb_root_password.txt base64
      configure_secret MONGODB_PASSWORD_FILE mongodb_password.txt base64
      configure_secret MONGODB_MIGRATION_PASSWORD_FILE mongodb_migration_password.txt base64
      configure_secret MONGODB_BACKUP_RESTORE_PASSWORD_FILE mongodb_backup_restore_password.txt base64
      configure_secret MONGODB_KEYFILE_FILE mongodb_keyfile.txt base64
      ;;
    mongodb/external-db)
      upsert_environment_value "${PRODUCTION_ENV}" MONGODB_DATABASE_TOOLS_DOCKER_NETWORK ''
      configure_secret MONGODB_URI_FILE mongodb_uri.txt empty
      configure_secret MONGODB_MIGRATION_URI_FILE mongodb_migration_uri.txt empty
      configure_secret MONGODB_BACKUP_RESTORE_URI_FILE mongodb_backup_restore_uri.txt empty
      ;;
    *) die 'DATABASE_ENGINE must be postgres or mongodb and COMPOSE_DATABASE_MODE must be bundled-db, external-db, or native' ;;
  esac

  # These values are issued by external systems and cannot be fabricated.
  # Empty protected files make required operator inputs explicit.
  configure_secret TELEGRAM_BOT_TOKEN_FILE telegram_bot_token.txt empty
  configure_secret TELEGRAM_OIDC_CLIENT_SECRET_FILE telegram_oidc_client_secret.txt empty
  configure_secret TELEGRAM_BOT_WEBHOOK_SECRET_FILE telegram_bot_webhook_secret.txt hex
  configure_secret DISCORD_BOT_TOKEN_FILE discord_bot_token.txt empty
  configure_secret DISCORD_CLIENT_SECRET_FILE discord_client_secret.txt empty
  configure_secret DISCORD_PUBLIC_KEY_FILE discord_public_key.txt empty
  configure_secret DISCORD_CUSTOM_ID_SECRET_FILE discord_custom_id_secret.txt hex
  configure_secret RESEND_API_KEY_FILE resend_api_key.txt empty
  configure_secret MAILPACE_SERVER_TOKEN_FILE mailpace_server_token.txt empty
  # Push signing material is issued by Google and Apple. The file has to exist even when the
  # product sends no push at all: Compose mounts a declared secret as a bind, so a missing source
  # file stops the notification containers from being created.
  configure_secret NOTIFICATION_FCM_PRIVATE_KEY_FILE notification_fcm_private_key.txt empty
  configure_secret NOTIFICATION_APNS_PRIVATE_KEY_FILE notification_apns_private_key.txt empty
}

initialize() {
  require_root
  require_command openssl
  validate_dedicated_path CONFIG_ROOT "${CONFIG_ROOT}"
  [[ ! -L "${CONFIG_ROOT}" ]] || die "CONFIG_ROOT must not be a symbolic link: ${CONFIG_ROOT}"
  mkdir -p "${CONFIG_ROOT}/secrets"
  [[ ! -L "${CONFIG_ROOT}/secrets" ]] || die "secrets directory must not be a symbolic link: ${CONFIG_ROOT}/secrets"
  chmod 700 "${CONFIG_ROOT}" "${CONFIG_ROOT}/secrets"

  if [[ ! -e "${SERVER_ENV}" ]]; then
    install -m 600 "${SOURCE_ROOT}/deploy/single-server/server.env.example" "${SERVER_ENV}"
    log "created ${SERVER_ENV}"
  else
    require_protected_regular_file "${SERVER_ENV}" 'server environment'
    log "kept existing ${SERVER_ENV}"
  fi

  if [[ ! -e "${PRODUCTION_ENV}" ]]; then
    install -m 600 "${SOURCE_ROOT}/.env.production.example" "${PRODUCTION_ENV}"
    upsert_environment_value "${PRODUCTION_ENV}" COMPOSE_DOMAIN_MODE external-proxy
    upsert_environment_value "${PRODUCTION_ENV}" COMPOSE_TLS_MODE external
    upsert_environment_value "${PRODUCTION_ENV}" EXTERNAL_PROXY_PUBLIC_MODE per-app-domains
    upsert_environment_value "${PRODUCTION_ENV}" TRUST_PROXY true
    upsert_environment_value "${PRODUCTION_ENV}" VITE_API_BASE_URL_MODE same-origin
    # The example targets Compose, whose service aliases (postgres, redis,
    # otel-collector) cannot resolve on a native host. Read RUNTIME_MODE directly:
    # init deliberately runs before load_server_environment.
    if [[ "$(environment_value RUNTIME_MODE "${SERVER_ENV}")" == 'native' ]]; then
      local app_root
      app_root="$(environment_value APP_ROOT "${SERVER_ENV}")"
      upsert_environment_value "${PRODUCTION_ENV}" COMPOSE_DATABASE_MODE native
      upsert_environment_value "${PRODUCTION_ENV}" POSTGRES_HOST 127.0.0.1
      upsert_environment_value "${PRODUCTION_ENV}" POSTGRES_USER nest_react_boilerplate
      upsert_environment_value "${PRODUCTION_ENV}" POSTGRES_DB nest_react_boilerplate
      upsert_environment_value "${PRODUCTION_ENV}" REDIS_URL redis://127.0.0.1:6379/0
      upsert_environment_value "${PRODUCTION_ENV}" REDIS_HOSTS ''
      # Nginx serves the built SPAs, so no SPA process exists to proxy to.
      upsert_environment_value "${PRODUCTION_ENV}" EXTERNAL_PROXY_FRONTEND_MODE static
      upsert_environment_value "${PRODUCTION_ENV}" FRONTEND_DIST_ROOT /srv/nest-react-boilerplate/frontend
      # No host collector ships with the native runtime; opt in deliberately instead
      # of failing every span export against an unresolvable container name.
      upsert_environment_value "${PRODUCTION_ENV}" OTEL_SDK_DISABLED true
      upsert_environment_value "${PRODUCTION_ENV}" OTEL_EXPORTER_OTLP_ENDPOINT ''
      log "created ${PRODUCTION_ENV} for the native runtime (app root ${app_root})"
    fi
    log "created ${PRODUCTION_ENV}"
  else
    require_protected_regular_file "${PRODUCTION_ENV}" 'production environment'
    log "kept existing ${PRODUCTION_ENV}"
  fi

  ensure_secret_material
  chmod 600 "${SERVER_ENV}" "${PRODUCTION_ENV}" "${CONFIG_ROOT}/secrets"/*
  DEPLOY_USER="$(environment_value DEPLOY_USER "${SERVER_ENV}")"
  if [[ "${DEPLOY_USER}" =~ ^[a-z_][a-z0-9_-]*$ ]] && id "${DEPLOY_USER}" >/dev/null 2>&1; then
    prepare_runtime_permissions
  fi
  log 'initialization complete; edit server.env and .env.production before apply'
}

apt_install() {
  DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "$@"
}

install_docker() {
  if command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; then
    log "Docker already installed: $(docker --version)"
    if dpkg-query -W -f='${Status}' docker-ce 2>/dev/null | grep -q 'install ok installed'; then
      apt_install docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
    fi
    return
  fi

  # Add Docker's official apt repository only when Docker is absent. Existing
  # operator-managed installations are preserved instead of being replaced.
  local architecture distribution codename repository
  architecture="$(dpkg --print-architecture)"
  # shellcheck disable=SC1091
  source /etc/os-release
  distribution="${ID}"
  codename="${VERSION_CODENAME}"
  [[ "${distribution}" == 'ubuntu' || "${distribution}" == 'debian' ]] || die 'Docker bootstrap supports Ubuntu and Debian'
  repository="https://download.docker.com/linux/${distribution}"
  install -m 0755 -d /etc/apt/keyrings
  curl -fsSL "${repository}/gpg" -o /etc/apt/keyrings/docker.asc
  chmod a+r /etc/apt/keyrings/docker.asc
  printf 'deb [arch=%s signed-by=/etc/apt/keyrings/docker.asc] %s %s stable\n' \
    "${architecture}" "${repository}" "${codename}" >/etc/apt/sources.list.d/docker.list
  apt-get update
  apt_install docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
  systemctl enable --now docker
}

install_node() {
  local expected="v${NODE_VERSION}"
  if command -v node >/dev/null 2>&1 && [[ "$(node --version)" == "${expected}" ]]; then
    log "Node.js already installed: ${expected}"
  else
    local machine node_arch archive work destination
    machine="$(uname -m)"
    case "${machine}" in
      x86_64) node_arch='x64' ;;
      aarch64|arm64) node_arch='arm64' ;;
      *) die "unsupported Node.js architecture: ${machine}" ;;
    esac
    archive="node-v${NODE_VERSION}-linux-${node_arch}.tar.xz"
    work="$(mktemp -d)"
    trap 'rm -rf "${work:-}"' RETURN
    curl -fsSLo "${work}/${archive}" "https://nodejs.org/dist/v${NODE_VERSION}/${archive}"
    curl -fsSLo "${work}/SHASUMS256.txt" "https://nodejs.org/dist/v${NODE_VERSION}/SHASUMS256.txt"
    (cd "${work}" && grep "  ${archive}\$" SHASUMS256.txt | sha256sum --check --strict -)
    destination="/usr/local/lib/nodejs/node-v${NODE_VERSION}-linux-${node_arch}"
    install -d /usr/local/lib/nodejs
    rm -rf "${destination}.new"
    mkdir "${destination}.new"
    tar -xJf "${work}/${archive}" --strip-components=1 -C "${destination}.new"
    rm -rf "${destination}"
    mv "${destination}.new" "${destination}"
    for executable in node npm npx; do
      ln -sfn "${destination}/bin/${executable}" "/usr/local/bin/${executable}"
    done
    trap - RETURN
    rm -rf "${work}"
    log "installed Node.js ${expected} from the checksummed official binary"
  fi

  install_corepack
  [[ "$(pnpm --version)" == "${PNPM_VERSION}" ]] || die 'pnpm activation failed'
}

install_corepack() {
  local install_root="${NRB_COREPACK_ROOT:-/usr/local/lib/nrb-corepack}"
  local shim_root="${NRB_BIN_ROOT:-/usr/local/bin}"
  local corepack_cli="${install_root}/lib/node_modules/corepack/dist/corepack.js"
  local node_binary
  node_binary="$(command -v node)"

  # Installing corepack into the shared /usr/local prefix makes npm create a shim for every
  # package manager corepack ships, and abort with EEXIST as soon as an operator or an earlier
  # Node installation already owns one of those names — a very common state on a rented VPS. Use a
  # controller-owned prefix with no bin links at all, and invoke the pinned CLI by absolute path.
  if [[ ! -x "${corepack_cli}" ]] || [[ "$("${node_binary}" "${corepack_cli}" --version 2>/dev/null)" != "${COREPACK_VERSION}" ]]; then
    if [[ -L "${install_root}" ]]; then
      rm -f "${install_root}"
    fi
    install -d "${install_root}"
    npm_config_prefix="${install_root}" npm install --global --no-bin-links --no-audit --no-fund \
      "corepack@${COREPACK_VERSION}"
  fi
  [[ "$("${node_binary}" "${corepack_cli}" --version)" == "${COREPACK_VERSION}" ]] ||
    die "corepack ${COREPACK_VERSION} did not install"

  "${node_binary}" "${corepack_cli}" install --global "pnpm@${PNPM_VERSION}"
  "${node_binary}" "${corepack_cli}" enable --install-directory "${shim_root}" pnpm
}

install_firewall() {
  [[ "${ENABLE_UFW}" == 'true' ]] || return
  apt_install ufw
  ufw allow "${SSH_PORT}/tcp"
  ufw allow 80/tcp
  ufw allow 443/tcp
  ufw --force enable
}

install_renewal_hook() {
  install -d -m 755 /etc/letsencrypt/renewal-hooks/deploy
  cat >/etc/letsencrypt/renewal-hooks/deploy/nrb-nginx-reload <<'HOOK'
#!/bin/sh
set -eu
nginx -t
systemctl reload nginx
HOOK
  chmod 755 /etc/letsencrypt/renewal-hooks/deploy/nrb-nginx-reload
}

install_controller_wrapper() {
  cat >/usr/local/sbin/nrb-server <<WRAPPER
#!/bin/sh
exec env NRB_CONFIG_ROOT=${CONFIG_ROOT} ${APP_ROOT}/deploy/single-server/serverctl "\$@"
WRAPPER
  chmod 755 /usr/local/sbin/nrb-server
}

prepare_runtime_permissions() {
  local deploy_group secret
  id "${DEPLOY_USER}" >/dev/null 2>&1 || die "deployment user ${DEPLOY_USER} is missing; run provision first"
  deploy_group="$(id -gn "${DEPLOY_USER}")"
  install -d -o root -g "${deploy_group}" -m 0750 "${CONFIG_ROOT}" "${CONFIG_ROOT}/secrets"
  chown root:root "${SERVER_ENV}"
  chmod 600 "${SERVER_ENV}"
  require_protected_regular_file "${PRODUCTION_ENV}" 'production environment'
  chown root:"${deploy_group}" "${PRODUCTION_ENV}"
  chmod 640 "${PRODUCTION_ENV}"
  for secret in "${CONFIG_ROOT}/secrets"/*; do
    [[ -e "${secret}" ]] || continue
    require_protected_regular_file "${secret}" 'secret'
    chown root:"${deploy_group}" "${secret}"
    chmod 640 "${secret}"
  done
}

resolve_deploy_home() {
  local home
  home="$(getent passwd "${DEPLOY_USER}" | cut -d: -f6)"
  validate_absolute_path DEPLOY_USER_HOME "${home}"
  printf '%s\n' "${home}"
}

pm2_unit_name() { printf 'pm2-%s\n' "${DEPLOY_USER}"; }

# Where nginx reads the built SPAs from. Never inside APP_ROOT: that is 0750 and
# owned by the deployment user, so www-data cannot traverse it, and rebuilding in
# place would rewrite files under live traffic.
frontend_web_root() {
  local configured
  configured="$(environment_value FRONTEND_DIST_ROOT)"
  printf '%s\n' "${configured:-/srv/nest-react-boilerplate/frontend}"
}

provision_native_runtime() {
  local home web_root
  home="$(resolve_deploy_home)"
  chmod 0750 "${home}"

  # Pinned like corepack, and under /usr/local so a Node upgrade does not remove it.
  if ! command -v pm2 >/dev/null 2>&1 || [[ "$(pm2 --version 2>/dev/null)" != "${PM2_VERSION}" ]]; then
    npm_config_prefix=/usr/local npm install --global "pm2@${PM2_VERSION}"
  fi

  # Host data services, unless an external database owns them.
  if [[ "$(environment_value COMPOSE_DATABASE_MODE)" == 'native' ]]; then
    /usr/local/bin/node "${APP_ROOT}/scripts/native-datastores.mjs" install
  fi

  web_root="$(frontend_web_root)"
  validate_dedicated_path FRONTEND_DIST_ROOT "${web_root}"
  case "${web_root}" in
    "${APP_ROOT}"|"${APP_ROOT}"/*) die 'FRONTEND_DIST_ROOT must be outside APP_ROOT so Nginx never reads the checkout' ;;
  esac
  install -d -o root -g root -m 0755 "${web_root}"

  # PM2's own generator owns boot resurrection; a second hand-rolled unit would be a
  # competing source of truth for the process list.
  pm2 startup systemd -u "${DEPLOY_USER}" --hp "${home}" >/dev/null
  systemctl enable "$(pm2_unit_name)" >/dev/null 2>&1 || true
  log "native runtime ready: pm2 ${PM2_VERSION}, web root ${web_root}"
}

provision() {
  require_root
  load_server_environment
  # shellcheck disable=SC1091
  source /etc/os-release
  [[ "${ID}" == 'ubuntu' || "${ID}" == 'debian' ]] || die 'single-server provisioning supports Ubuntu and Debian'
  apt-get update
  apt_install ca-certificates certbot curl dnsutils git gnupg jq nginx openssl rsync xz-utils
  if [[ "${ENABLE_UNATTENDED_UPGRADES}" == 'true' ]]; then
    apt_install unattended-upgrades
    systemctl enable --now unattended-upgrades
  fi
  # Docker is a Compose-runtime dependency only. A native host neither installs it
  # nor puts the deployment user in the docker group, which is root-equivalent.
  [[ "${RUNTIME_MODE}" != 'compose' ]] || install_docker
  install_node

  if ! id "${DEPLOY_USER}" >/dev/null 2>&1; then
    useradd --create-home --shell /bin/bash "${DEPLOY_USER}"
  fi
  [[ "${RUNTIME_MODE}" != 'compose' ]] || usermod -aG docker "${DEPLOY_USER}"
  install -d -o "${DEPLOY_USER}" -g "${DEPLOY_USER}" -m 0750 "${APP_ROOT}"
  chown -R "${DEPLOY_USER}:${DEPLOY_USER}" "${APP_ROOT}"
  install -d -o root -g root -m 0700 "${STATE_ROOT}"
  prepare_runtime_permissions
  install -d -o www-data -g www-data -m 0755 /var/www/certbot
  rm -f /etc/nginx/sites-enabled/default
  install_renewal_hook
  local units=(nginx certbot.timer)
  [[ "${RUNTIME_MODE}" != 'compose' ]] || units=(docker "${units[@]}")
  systemctl enable --now "${units[@]}"
  [[ "${RUNTIME_MODE}" != 'native' ]] || provision_native_runtime
  install_firewall
  install_controller_wrapper

  if [[ "${CERTIFICATE_MODE:-}" == 'dns-wildcard' ]]; then
    [[ "${CERTBOT_DNS_PACKAGE:-}" =~ ^[a-z0-9][a-z0-9+.-]*$ ]] || die 'CERTBOT_DNS_PACKAGE is invalid'
    apt_install "${CERTBOT_DNS_PACKAGE}"
  fi
  log 'host provisioning converged successfully'
}

require_app_checkout() {
  [[ -d "${APP_ROOT}/.git" ]] || die "application checkout missing at ${APP_ROOT}; run bootstrap.sh or clone the repository"
  [[ -f "${APP_ROOT}/scripts/single-server-deployment.mjs" ]] || die 'checkout does not contain single-server deployment tooling'
}

validate_secret_file() {
  local key="$1" path mode owner
  path="$(environment_value "${key}")"
  [[ "${path}" == /* ]] || die "${key} must be an absolute path"
  [[ -s "${path}" ]] || die "${key} is missing or empty: ${path}"
  [[ ! -L "${path}" ]] || die "${key} must not be a symbolic link"
  mode="$(stat -c '%a' "${path}")"
  owner="$(stat -c '%U' "${path}")"
  [[ "${owner}" == 'root' ]] || die "${key} must be owned by root (got ${owner})"
  [[ "${mode}" == '640' || "${mode}" == '440' ]] || die "${key} must have mode 640 or 440 (got ${mode})"
  run_as_deploy test -r "${path}" || die "${key} must be readable by ${DEPLOY_USER} through its protected group"
}

validate_secret_minimum_length() {
  local key="$1" minimum="$2" path length
  path="$(environment_value "${key}")"
  length="$(tr -d '\r\n' <"${path}" | wc -c)"
  ((length >= minimum)) || die "${key} must contain at least ${minimum} characters"
}

validate_generated_secret_contracts() {
  local encryption_key webhook_secret
  validate_secret_minimum_length SESSION_SECRET_FILE 32
  validate_secret_minimum_length BETTER_AUTH_SECRET_FILE 32
  validate_secret_minimum_length REDIS_PASSWORD_FILE 32
  validate_secret_minimum_length GRAFANA_ADMIN_PASSWORD_FILE 32
  encryption_key="$(environment_value AUTH_PROVIDER_TOKEN_ENCRYPTION_KEY_FILE)"
  if ! grep -Eq '^[A-Fa-f0-9]{64}$' "${encryption_key}"; then
    [[ "$(openssl base64 -d -A <"${encryption_key}" | wc -c)" -eq 32 ]] || \
      die 'AUTH_PROVIDER_TOKEN_ENCRYPTION_KEY_FILE must contain 32-byte base64 or 64-character hex material'
  fi
  grep -Eq '^[^[:space:]]{32,256}$' "$(environment_value REDIS_PASSWORD_FILE)" || \
    die 'REDIS_PASSWORD_FILE must contain one non-whitespace password of 32 through 256 characters'
  webhook_secret="$(environment_value TELEGRAM_BOT_WEBHOOK_SECRET_FILE)"
  grep -Eq '^[A-Za-z0-9_-]{32,256}$' "${webhook_secret}" || \
    die 'TELEGRAM_BOT_WEBHOOK_SECRET_FILE must contain 32 through 256 allowed token characters'
}

validate_configuration() {
  require_app_checkout
  [[ -f "${PRODUCTION_ENV}" ]] || die "missing ${PRODUCTION_ENV}; run init first"
  prepare_runtime_permissions
  /usr/local/bin/node "${APP_ROOT}/scripts/single-server-deployment.mjs" validate \
    --server-env "${SERVER_ENV}" --production-env "${PRODUCTION_ENV}"

  local image_tag image_registry database_engine database_mode configured_profiles public_domain
  image_tag="$(environment_value IMAGE_TAG)"
  image_registry="$(environment_value IMAGE_REGISTRY)"
  database_mode="$(environment_value COMPOSE_DATABASE_MODE)"
  database_engine="$(environment_value DATABASE_ENGINE)"
  database_engine="${database_engine:-postgres}"
  configured_profiles=",$(environment_value COMPOSE_PROFILES),"
  public_domain="$(environment_value PUBLIC_DOMAIN)"
  # An immutable published tag is the deployment identity only when images are pulled.
  # Locally built images carry the same tag without a registry, and a native host has
  # no images at all.
  if [[ "${RUNTIME_MODE}" == 'compose' && "${IMAGE_SOURCE}" == 'registry' ]]; then
    [[ "${image_tag}" =~ ^sha-[0-9a-f]{7,64}$ ]] || die 'IMAGE_TAG must be an immutable sha-<git-sha> tag'
    [[ "${image_tag}" != 'sha-000000000000' ]] || die 'replace the placeholder IMAGE_TAG with a released immutable image tag'
    [[ -n "${image_registry}" && "${image_registry}" != *your-github-org* ]] || die 'set IMAGE_REGISTRY to the real image repository'
  fi
  [[ "${public_domain}" != 'example.com' ]] || die 'replace the placeholder PUBLIC_DOMAIN before deployment'
  [[ "${CERTIFICATE_NAME:-}" != 'example.com' ]] || die 'replace the placeholder CERTIFICATE_NAME before deployment'
  if [[ "${CERTIFICATE_MODE}" != 'existing' ]]; then
    [[ "${CERTBOT_EMAIL}" != *@example.com ]] || die 'replace the placeholder CERTBOT_EMAIL before deployment'
  fi
  [[ "$(environment_value TRUST_PROXY)" == 'true' ]] || die 'TRUST_PROXY must be true behind host Nginx'
  [[ "$(environment_value VITE_API_BASE_URL_MODE)" == 'same-origin' ]] || die 'VITE_API_BASE_URL_MODE must be same-origin'
  local frontend_api_base_url
  for frontend_api_base_url in VITE_AUTH_API_BASE_URL VITE_USER_API_BASE_URL VITE_ADMIN_API_BASE_URL; do
    [[ -z "$(environment_value "${frontend_api_base_url}")" ]] || \
      die "${frontend_api_base_url} must be empty in same-origin mode"
  done

  validate_secret_file SESSION_SECRET_FILE
  validate_secret_file BETTER_AUTH_SECRET_FILE
  validate_secret_file AUTH_PROVIDER_TOKEN_ENCRYPTION_KEY_FILE
  if [[ "${configured_profiles}" == *,notification-scheduler,* || "${configured_profiles}" == *,notification-consumer,* ]]; then
    validate_secret_file NOTIFICATION_PAYLOAD_ENCRYPTION_KEY_FILE
    local notification_encryption_key
    notification_encryption_key="$(environment_value NOTIFICATION_PAYLOAD_ENCRYPTION_KEY_FILE)"
    if ! grep -Eq '^[0-9A-Fa-f]{64}$|^[A-Za-z0-9+/]{43}=$|^[A-Za-z0-9+/]{44}$' "${notification_encryption_key}"; then
      die 'NOTIFICATION_PAYLOAD_ENCRYPTION_KEY_FILE must contain 32-byte base64 or 64-character hex material'
    fi
    case "$(environment_value NOTIFICATION_EMAIL_PROVIDER)" in
      resend) validate_secret_file RESEND_API_KEY_FILE ;;
      mailpace) validate_secret_file MAILPACE_SERVER_TOKEN_FILE ;;
      *) die 'NOTIFICATION_EMAIL_PROVIDER must be resend or mailpace' ;;
    esac
    case "$(environment_value AUTH_NOTIFICATION_PROVIDER)" in
      telegram-bot) validate_secret_file TELEGRAM_BOT_TOKEN_FILE ;;
      discord-bot) validate_secret_file DISCORD_BOT_TOKEN_FILE ;;
      resend|mailpace) ;;
      *) die 'AUTH_NOTIFICATION_PROVIDER must be telegram-bot, discord-bot, resend, or mailpace' ;;
    esac
  fi
  validate_secret_file REDIS_PASSWORD_FILE
  # Grafana only exists as a Compose service, so a native host has no consumer for it.
  [[ "${RUNTIME_MODE}" != 'compose' ]] || validate_secret_file GRAFANA_ADMIN_PASSWORD_FILE
  validate_generated_secret_contracts
  [[ "$(environment_value AUTH_PROVIDER_TOKEN_ENCRYPTION_ENABLED)" == 'true' ]] || \
    die 'AUTH_PROVIDER_TOKEN_ENCRYPTION_ENABLED must be true for the single-server production deployment'
  case "${database_engine}/${database_mode}" in
    postgres/bundled-db)
      [[ "${RUNTIME_MODE}" == 'compose' ]] || die 'COMPOSE_DATABASE_MODE=bundled-db needs the compose runtime'
      validate_secret_file POSTGRES_PASSWORD_FILE
      validate_secret_minimum_length POSTGRES_PASSWORD_FILE 32
      ;;
    postgres/external-db)
      validate_secret_file DATABASE_URL_FILE
      ;;
    mongodb/bundled-db)
      [[ "${RUNTIME_MODE}" == 'compose' ]] || die 'COMPOSE_DATABASE_MODE=bundled-db needs the compose runtime'
      log 'WARNING: bundled MongoDB is a transaction-capable single-node replica set and is not highly available'
      validate_secret_file MONGODB_ROOT_PASSWORD_FILE
      validate_secret_file MONGODB_PASSWORD_FILE
      validate_secret_file MONGODB_MIGRATION_PASSWORD_FILE
      validate_secret_file MONGODB_BACKUP_RESTORE_PASSWORD_FILE
      validate_secret_file MONGODB_KEYFILE_FILE
      validate_secret_minimum_length MONGODB_ROOT_PASSWORD_FILE 32
      validate_secret_minimum_length MONGODB_PASSWORD_FILE 32
      validate_secret_minimum_length MONGODB_MIGRATION_PASSWORD_FILE 32
      validate_secret_minimum_length MONGODB_BACKUP_RESTORE_PASSWORD_FILE 32
      validate_secret_minimum_length MONGODB_KEYFILE_FILE 6
      ;;
    mongodb/external-db)
      [[ "${RUNTIME_MODE}" == 'compose' ]] || die 'RUNTIME_MODE=native supports PostgreSQL only'
      validate_secret_file MONGODB_URI_FILE
      validate_secret_file MONGODB_MIGRATION_URI_FILE
      validate_secret_file MONGODB_BACKUP_RESTORE_URI_FILE
      ;;
    postgres/native)
      [[ "${RUNTIME_MODE}" == 'native' ]] || die 'COMPOSE_DATABASE_MODE=native needs RUNTIME_MODE=native'
      validate_secret_file POSTGRES_PASSWORD_FILE
      validate_secret_minimum_length POSTGRES_PASSWORD_FILE 32
      # PostgreSQL installed on this host: loopback-only, with a dedicated role. The
      # provisioner refuses the superuser, so catching it here fails early instead.
      [[ "$(environment_value POSTGRES_USER)" != 'postgres' ]] || \
        die 'POSTGRES_USER must be a dedicated non-superuser role for a host database'
      ;;
    mongodb/native) die 'RUNTIME_MODE=native supports PostgreSQL only' ;;
    *) die 'DATABASE_ENGINE must be postgres or mongodb and COMPOSE_DATABASE_MODE must be bundled-db, external-db, or native' ;;
  esac
  if [[ "${RUNTIME_MODE}" == 'native' ]]; then
    # Nginx reads the published tree directly, so it must be a real path outside the
    # deploy-user-owned checkout — otherwise every asset 403s and the renderer would
    # silently point at ${APP_ROOT}/dist, which www-data cannot traverse.
    local dist_root
    dist_root="$(environment_value FRONTEND_DIST_ROOT)"
    [[ -n "${dist_root}" ]] || die 'RUNTIME_MODE=native requires FRONTEND_DIST_ROOT in the production environment'
    validate_dedicated_path FRONTEND_DIST_ROOT "${dist_root}"
    case "${dist_root}" in
      "${APP_ROOT}"|"${APP_ROOT}"/*) die 'FRONTEND_DIST_ROOT must be outside APP_ROOT so Nginx never reads the checkout' ;;
    esac
  fi
  if [[ "${configured_profiles}" == *,telegram,* ]]; then
    validate_secret_file TELEGRAM_BOT_TOKEN_FILE
    validate_secret_file TELEGRAM_OIDC_CLIENT_SECRET_FILE
    validate_secret_file TELEGRAM_BOT_WEBHOOK_SECRET_FILE
    [[ "$(environment_value TELEGRAM_BOT_USERNAME)" != 'example_bot' ]] || die 'set TELEGRAM_BOT_USERNAME for the telegram profile'
    [[ "$(environment_value TELEGRAM_OIDC_CLIENT_ID)" != '123456789' ]] || die 'set TELEGRAM_OIDC_CLIENT_ID for the telegram profile'
  fi
  if [[ "${configured_profiles}" == *,discord,* ]]; then
    validate_secret_file DISCORD_BOT_TOKEN_FILE
    validate_secret_file DISCORD_CLIENT_SECRET_FILE
    validate_secret_file DISCORD_PUBLIC_KEY_FILE
    validate_secret_file DISCORD_CUSTOM_ID_SECRET_FILE
    [[ "$(environment_value DISCORD_CLIENT_ID)" != example-* ]] || die 'set DISCORD_CLIENT_ID for the discord profile'
    [[ "$(environment_value DISCORD_APPLICATION_ID)" != example-* ]] || die 'set DISCORD_APPLICATION_ID for the discord profile'
  fi

  if [[ "${RUNTIME_MODE}" == 'compose' ]]; then
    run_as_deploy /usr/local/bin/node "${APP_ROOT}/scripts/compose-production.mjs" config \
      --env-file "${PRODUCTION_ENV}" --dry-run >/dev/null
  else
    # The native equivalents: the process manifest is a real contract, and resolving
    # the runtime environment proves every secret file and endpoint is usable before
    # anything starts. `keys` prints names only, never values.
    /usr/local/bin/node "${APP_ROOT}/scripts/validate-pm2-config.mjs" >/dev/null
    /usr/local/bin/node "${APP_ROOT}/scripts/native-runtime-env.mjs" keys \
      --production-env="${PRODUCTION_ENV}" >/dev/null
  fi
}

render_nginx() {
  local phase="$1" destination='/etc/nginx/conf.d/nest-react-boilerplate.conf' temporary backup=''
  temporary="$(mktemp /etc/nginx/conf.d/nest-react-boilerplate.conf.XXXXXX)"
  /usr/local/bin/node "${APP_ROOT}/scripts/single-server-deployment.mjs" render-nginx \
    --server-env "${SERVER_ENV}" --production-env "${PRODUCTION_ENV}" \
    --phase "${phase}" --output "${temporary}"
  if [[ -f "${destination}" ]]; then
    backup="$(mktemp /etc/nginx/conf.d/nest-react-boilerplate.backup.XXXXXX)"
    cp -a "${destination}" "${backup}"
  fi
  chmod 644 "${temporary}"
  mv -f "${temporary}" "${destination}"
  if ! nginx -t; then
    if [[ -n "${backup}" ]]; then mv -f "${backup}" "${destination}"; else rm -f "${destination}"; fi
    nginx -t || true
    die 'generated Nginx configuration failed validation; previous configuration restored'
  fi
  [[ -z "${backup}" ]] || rm -f "${backup}"
  systemctl reload nginx
}

certificate_domains() {
  /usr/local/bin/node "${APP_ROOT}/scripts/single-server-deployment.mjs" certificate-domains \
    --server-env "${SERVER_ENV}" --production-env "${PRODUCTION_ENV}"
}

public_hosts() {
  /usr/local/bin/node "${APP_ROOT}/scripts/single-server-deployment.mjs" hosts \
    --server-env "${SERVER_ENV}" --production-env "${PRODUCTION_ENV}"
}

certificate_covers_domains() {
  local certificate="/etc/letsencrypt/live/${CERTIFICATE_NAME}/fullchain.pem" required
  [[ -f "${certificate}" ]] || return 1
  openssl x509 -checkend 604800 -noout -in "${certificate}" >/dev/null || return 1
  while IFS= read -r required; do
    openssl x509 -in "${certificate}" -noout -checkhost "${required}" >/dev/null || return 1
  done < <(public_hosts)
  if [[ "${CERTIFICATE_MODE}" == 'dns-wildcard' ]]; then
    openssl x509 -in "${certificate}" -noout -checkhost "nrb-wildcard-check.$(environment_value PUBLIC_DOMAIN)" >/dev/null || return 1
  fi
}

ensure_dns_resolves() {
  local host failed=false
  while IFS= read -r host; do
    if ! getent ahosts "${host}" >/dev/null 2>&1; then
      log "DNS does not resolve: ${host}"
      failed=true
    fi
  done < <(public_hosts)
  [[ "${failed}" == 'false' ]] || die 'create the documented apex/exact/wildcard DNS records before certificate issuance'
}

ensure_certificate() {
  mapfile -t domains < <(certificate_domains)
  ((${#domains[@]} > 0)) || die 'no certificate domains were derived'
  if certificate_covers_domains; then
    log "certificate ${CERTIFICATE_NAME} already covers every host and is valid for at least seven days"
    return
  fi
  [[ "${CERTIFICATE_MODE}" != 'existing' ]] || die 'the existing certificate is missing, expiring, or does not cover every required domain'
  ensure_dns_resolves

  local domain_args=() domain
  for domain in "${domains[@]}"; do domain_args+=(-d "${domain}"); done
  if [[ "${CERTIFICATE_MODE}" == 'exact-hosts' ]]; then
    certbot certonly --non-interactive --agree-tos --email "${CERTBOT_EMAIL}" \
      --cert-name "${CERTIFICATE_NAME}" --webroot -w /var/www/certbot \
      --keep-until-expiring --renew-with-new-domains "${domain_args[@]}"
  else
    [[ "${CERTBOT_DNS_PLUGIN}" =~ ^[a-z0-9-]+$ ]] || die 'CERTBOT_DNS_PLUGIN is invalid'
    [[ -s "${CERTBOT_DNS_CREDENTIALS}" ]] || die 'CERTBOT_DNS_CREDENTIALS is missing or empty'
    require_protected_regular_file "${CERTBOT_DNS_CREDENTIALS}" 'Certbot DNS credentials'
    chmod 600 "${CERTBOT_DNS_CREDENTIALS}"
    local credential_flag="--dns-${CERTBOT_DNS_PLUGIN}-credentials"
    local propagation_flag="--dns-${CERTBOT_DNS_PLUGIN}-propagation-seconds"
    certbot certonly --non-interactive --agree-tos --email "${CERTBOT_EMAIL}" \
      --cert-name "${CERTIFICATE_NAME}" --authenticator "dns-${CERTBOT_DNS_PLUGIN}" \
      "${credential_flag}" "${CERTBOT_DNS_CREDENTIALS}" \
      "${propagation_flag}" "${CERTBOT_DNS_PROPAGATION_SECONDS:-60}" \
      --keep-until-expiring --renew-with-new-domains "${domain_args[@]}"
  fi
  certificate_covers_domains || die 'Certbot returned without a valid certificate covering every required domain'
}

install_compose_unit() {
  local deploy_group deploy_home pull_line no_build
  deploy_group="$(id -gn "${DEPLOY_USER}")"
  deploy_home="$(resolve_deploy_home)"
  # Registry provenance pulls immutable tags before starting and never builds.
  # Local provenance has nothing to pull, and the wrapper adds --build itself — so
  # passing --no-build too would make Compose reject the invocation outright.
  if [[ "${IMAGE_SOURCE}" == 'registry' ]]; then
    pull_line="ExecStartPre=/usr/local/bin/node ${APP_ROOT}/scripts/compose-production.mjs pull --env-file=${PRODUCTION_ENV}"
    no_build=' --no-build'
  else
    pull_line="# COMPOSE_IMAGE_SOURCE=local builds images on this host; nothing to pull."
    no_build=''
  fi
  cat >/etc/systemd/system/nest-react-boilerplate.service <<UNIT
[Unit]
Description=Nest React Boilerplate production Compose application
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=${DEPLOY_USER}
Group=${deploy_group}
SupplementaryGroups=docker
WorkingDirectory=${APP_ROOT}
Environment="HOME=${deploy_home}"
${pull_line}
ExecStart=/usr/local/bin/node ${APP_ROOT}/scripts/compose-production.mjs up --env-file=${PRODUCTION_ENV} -d --remove-orphans --wait --wait-timeout=300${no_build}
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
UNIT
  systemctl daemon-reload
  systemctl enable nest-react-boilerplate.service
}

# A host that switches runtimes must not keep the other runtime's boot unit enabled,
# or a reboot starts a stack this controller no longer manages.
disable_foreign_runtime_unit() {
  if [[ "${RUNTIME_MODE}" == 'native' ]]; then
    if systemctl list-unit-files nest-react-boilerplate.service >/dev/null 2>&1; then
      systemctl disable --now nest-react-boilerplate.service >/dev/null 2>&1 || true
    fi
  else
    local unit
    unit="$(pm2_unit_name)"
    if systemctl list-unit-files "${unit}.service" >/dev/null 2>&1; then
      systemctl disable --now "${unit}" >/dev/null 2>&1 || true
    fi
  fi
}

# Build, publish, migrate, and (re)start the PM2 process tree.
#
# The ordered sequence itself lives in scripts/native-release.mjs, shared with
# `pnpm deploy --preset=native`, so the two entry points cannot drift. Secrets reach
# the processes through scripts/native-runtime-env.mjs, which dereferences the
# protected *_FILE material into the child environment — never into argv or a file.
release_native() {
  local skip_migrations="${1:-false}" home web_root entry
  local flags=() start_args=()
  home="$(resolve_deploy_home)"
  web_root="$(frontend_web_root)"

  # Which optional processes this topology needs, derived from the rendered edge
  # rather than restated: the SSR site is a process even when SPAs come from disk.
  local profiles
  profiles="$(environment_value COMPOSE_PROFILES)"
  [[ "${profiles}" != *discord* ]] || flags+=(--pm2-flag=PM2_ENABLE_DISCORD)
  [[ "${profiles}" != *telegram* ]] || flags+=(--pm2-flag=PM2_ENABLE_TELEGRAM)
  [[ "${profiles}" != *notification-* ]] || flags+=(--pm2-flag=PM2_ENABLE_NOTIFICATIONS)
  while IFS= read -r entry; do
    [[ "${entry%%=*}" != 'SITE_APP_PORT' ]] || flags+=(--pm2-flag=PM2_ENABLE_SITE)
  done < <(expected_ports)

  # Install and build as the deployment user, inside its own checkout.
  run_as_deploy /usr/local/bin/node "${APP_ROOT}/scripts/native-release.mjs" build \
    --production-env="${PRODUCTION_ENV}" --app-root="${APP_ROOT}"

  # Publish to a root-owned web root: Nginx cannot traverse APP_ROOT, and building in
  # place would rewrite files while they are being served.
  install -d -o root -g root -m 0755 "${web_root}"
  rsync -a --delete --chmod=D755,F644 "${APP_ROOT}/dist/apps/frontend/" "${web_root}/"

  start_args=(--production-env="${PRODUCTION_ENV}" --app-root="${APP_ROOT}" "${flags[@]}")
  [[ "${skip_migrations}" != 'true' ]] || start_args+=(--skip-migrations)
  # `9>&-` closes the controller's flock before PM2 daemonizes: an inherited lock fd
  # in the detached daemon would make every later operation report a running one.
  run_as_deploy /usr/local/bin/node "${APP_ROOT}/scripts/native-release.mjs" start \
    "${start_args[@]}" 9>&-

  # pm2 save persists the fully resolved environment, so the dump is as sensitive as
  # the secret files it came from.
  chmod 700 "${home}/.pm2" 2>/dev/null || true
  chmod 600 "${home}/.pm2/dump.pm2" 2>/dev/null || true
}

wait_for_https() {
  local host attempt
  while IFS= read -r host; do
    for ((attempt = 1; attempt <= HEALTHCHECK_RETRIES; attempt += 1)); do
      if curl --fail --silent --show-error --max-time 10 \
        --resolve "${host}:443:127.0.0.1" "https://${host}/_infra/health" | grep -qx ok; then
        break
      fi
      if ((attempt == HEALTHCHECK_RETRIES)); then die "HTTPS health check failed for ${host}"; fi
      sleep "${HEALTHCHECK_INTERVAL_SECONDS}"
    done
  done < <(public_hosts)
}

write_state_value() {
  local path="$1" value="$2" temporary
  temporary="$(mktemp "${path}.XXXXXX")"
  printf '%s\n' "${value}" >"${temporary}"
  chmod 600 "${temporary}"
  mv -f "${temporary}" "${path}"
}

record_successful_tag() {
  local tag previous=''
  tag="$(environment_value IMAGE_TAG)"
  [[ ! -f "${STATE_ROOT}/current-image-tag" ]] || previous="$(<"${STATE_ROOT}/current-image-tag")"
  if [[ -n "${previous}" && "${previous}" != "${tag}" ]]; then
    write_state_value "${STATE_ROOT}/previous-image-tag" "${previous}"
  fi
  write_state_value "${STATE_ROOT}/current-image-tag" "${tag}"
}

# A native release has no image artifact, so the deployed commit is its identity.
record_successful_commit() {
  local commit previous=''
  commit="$(run_as_deploy git -C "${APP_ROOT}" rev-parse HEAD)"
  [[ ! -f "${STATE_ROOT}/current-commit" ]] || previous="$(<"${STATE_ROOT}/current-commit")"
  if [[ -n "${previous}" && "${previous}" != "${commit}" ]]; then
    write_state_value "${STATE_ROOT}/previous-commit" "${previous}"
  fi
  write_state_value "${STATE_ROOT}/current-commit" "${commit}"
}

record_successful_release() {
  if [[ "${RUNTIME_MODE}" == 'compose' ]]; then record_successful_tag; else record_successful_commit; fi
}

deployed_identity() {
  if [[ "${RUNTIME_MODE}" == 'compose' ]]; then
    printf '%s (images: %s)\n' "$(environment_value IMAGE_TAG)" "${IMAGE_SOURCE}"
  else
    printf 'commit %s\n' "$(run_as_deploy git -C "${APP_ROOT}" rev-parse --short HEAD)"
  fi
}

deploy() {
  local skip_migrations="${1:-false}"
  require_root
  load_server_environment
  ensure_secret_material
  prepare_runtime_permissions
  validate_configuration
  disable_foreign_runtime_unit
  # The HTTP phase keeps the ACME path reachable while the runtime converges; a
  # native host must not render an HTTPS config whose roots do not exist yet.
  if [[ "${RUNTIME_MODE}" == 'compose' ]] && certificate_covers_domains; then
    render_nginx https
  else
    render_nginx http
  fi
  if [[ "${RUNTIME_MODE}" == 'compose' ]]; then
    if [[ "${IMAGE_SOURCE}" == 'local' ]]; then
      # Build before the unit starts: a multi-minute image build inside a oneshot
      # ExecStartPre would hit TimeoutStartSec.
      run_as_deploy /usr/local/bin/node "${APP_ROOT}/scripts/compose-production.mjs" build \
        --env-file "${PRODUCTION_ENV}"
    fi
    install_compose_unit
    systemctl restart nest-react-boilerplate.service
  else
    release_native "${skip_migrations}"
  fi
  ensure_certificate
  render_nginx https
  wait_for_https
  check_runtime_health
  check_application_readiness
  record_successful_release
  log "deployment healthy: $(deployed_identity)"
}

update_checkout() {
  require_app_checkout
  local dirty
  dirty="$(run_as_deploy git -C "${APP_ROOT}" status --porcelain)"
  [[ -z "${dirty}" ]] || die "${APP_ROOT} has uncommitted changes; refusing to overwrite them"
  run_as_deploy git -C "${APP_ROOT}" fetch --prune origin
  run_as_deploy git -C "${APP_ROOT}" checkout "${REPOSITORY_BRANCH}"
  run_as_deploy git -C "${APP_ROOT}" merge --ff-only "origin/${REPOSITORY_BRANCH}"
  # In compose runtime mode the controller uses Node built-ins only: runtime images
  # are prebuilt and pulled by the systemd unit, so an application update never
  # recompiles the workspace or reinstalls its dependency graph on the host. The
  # native runtime is the deliberate exception — it has no prebuilt artifact, so
  # release_native installs and builds from this checkout.
}

set_image_tag() {
  local next="$1" current
  [[ "${next}" =~ ^sha-[0-9a-f]{7,64}$ ]] || die '--image-tag must be an immutable sha-<git-sha> tag'
  current="$(environment_value IMAGE_TAG)"
  if [[ "${current}" != "${next}" ]]; then
    upsert_environment_value "${PRODUCTION_ENV}" IMAGE_TAG "${next}"
  fi
}

update_application() {
  require_root
  load_server_environment
  [[ "${SYSTEM_UPDATE}" == 'false' ]] || provision
  update_checkout
  [[ -z "${IMAGE_TAG_OVERRIDE}" ]] || set_image_tag "${IMAGE_TAG_OVERRIDE}"
  deploy
}

rollback_application() {
  require_root
  load_server_environment
  [[ "${ASSUME_YES}" == 'true' ]] || die 'rollback requires --yes: the runtime rolls back, but database migrations are not reversed and must be backward-compatible'
  if [[ "${RUNTIME_MODE}" == 'native' ]]; then
    # An immutable image can always be re-pulled; a native rollback would have to
    # rebuild from source, and a failed rebuild would leave the host with neither the
    # old nor the new dist. Retained per-commit release trees are the prerequisite,
    # so refuse rather than offer a rollback that can destroy a working host.
    local previous='(none recorded)'
    [[ ! -f "${STATE_ROOT}/previous-commit" ]] || previous="$(<"${STATE_ROOT}/previous-commit")"
    die "automatic rollback is not available for RUNTIME_MODE=native: it would rebuild in place. Roll back manually with 'sudo -u ${DEPLOY_USER} git -C ${APP_ROOT} checkout --detach ${previous}' then '${CONTROLLER_NAME} deploy'; migrations are never re-run."
  fi
  [[ -f "${STATE_ROOT}/current-image-tag" ]] || die 'no successful image tag is recorded'
  local selected last_successful target
  selected="$(environment_value IMAGE_TAG)"
  last_successful="$(<"${STATE_ROOT}/current-image-tag")"
  if [[ "${selected}" != "${last_successful}" ]]; then
    target="${last_successful}"
  else
    [[ -f "${STATE_ROOT}/previous-image-tag" ]] || die 'no previous successful image tag is recorded'
    target="$(<"${STATE_ROOT}/previous-image-tag")"
  fi
  set_image_tag "${target}"
  deploy
}

renew_certificates() {
  require_root
  load_server_environment
  [[ "${CERTIFICATE_MODE}" != 'existing' ]] || die 'CERTIFICATE_MODE=existing is renewed by the external certificate owner'
  certbot renew --cert-name "${CERTIFICATE_NAME}" --deploy-hook /etc/letsencrypt/renewal-hooks/deploy/nrb-nginx-reload
  certificate_covers_domains || die 'renewed certificate is invalid, expiring, or missing required domains'
}

# The ports that must have a listener for THIS topology, derived by the planner from
# the runtime, the frontend mode and the enabled profiles. Hardcoding them here made
# doctor demand container-only observability ports on a native host and SPA processes
# a static deployment never starts.
expected_ports() {
  /usr/local/bin/node "${APP_ROOT}/scripts/single-server-deployment.mjs" expected-ports \
    --server-env "${SERVER_ENV}" --production-env "${PRODUCTION_ENV}"
}

check_loopback_bindings() {
  local entries=() entry port addresses
  mapfile -t entries < <(expected_ports)
  # A failed process substitution leaves an empty array, and an empty loop would
  # silently check nothing.
  ((${#entries[@]} > 0)) || die 'no expected listening ports were derived'
  for entry in "${entries[@]}"; do
    port="${entry##*=}"
    addresses="$(ss -H -ltn "sport = :${port}" | awk '{print $4}')"
    [[ -n "${addresses}" ]] || die "expected application port ${port} (${entry%%=*}) is not listening"
    if grep -Evq '^(127\.0\.0\.1|\[::1\]):' <<<"${addresses}"; then
      die "application port ${port} is listening beyond loopback"
    fi
  done
}

# nginx answers /_infra/health itself, so wait_for_https proves nothing about the
# application. Probe the runtime's own readiness endpoint on every expected port.
check_application_readiness() {
  local entries=() entry key port attempt
  mapfile -t entries < <(expected_ports)
  ((${#entries[@]} > 0)) || die 'no expected listening ports were derived'
  for entry in "${entries[@]}"; do
    key="${entry%%=*}"
    # Only the application services expose /ready; observability containers do not.
    [[ "${key}" == *_API_PORT || "${key}" == 'SITE_APP_PORT' ]] || continue
    port="${entry##*=}"
    for ((attempt = 1; attempt <= HEALTHCHECK_RETRIES; attempt += 1)); do
      if curl --fail --silent --show-error --max-time 5 "http://127.0.0.1:${port}/ready" >/dev/null; then
        break
      fi
      if ((attempt == HEALTHCHECK_RETRIES)); then die "${key} on port ${port} never became ready"; fi
      sleep "${HEALTHCHECK_INTERVAL_SECONDS}"
    done
  done
}

check_compose_health() {
  local state
  state="$(run_as_deploy /usr/local/bin/node "${APP_ROOT}/scripts/compose-production.mjs" ps \
    --env-file "${PRODUCTION_ENV}" --all --format json)"
  jq -s -e '
    flatten
    | length > 0
    and all(.[];
      if .Service == "migrate"
      then .State == "exited" and .ExitCode == 0
      else .State == "running" and ((.Health // "") != "unhealthy")
      end
    )
  ' <<<"${state}" >/dev/null || die 'one or more production Compose services are stopped or unhealthy'
}

# The PM2 apps this topology is supposed to be running, derived from the same flags
# release_native passes, so the health check cannot pass with a worker missing.
expected_pm2_apps() {
  local profiles flags=()
  profiles="$(environment_value COMPOSE_PROFILES)"
  [[ "${profiles}" != *discord* ]] || flags+=(--pm2-flag=PM2_ENABLE_DISCORD)
  [[ "${profiles}" != *telegram* ]] || flags+=(--pm2-flag=PM2_ENABLE_TELEGRAM)
  [[ "${profiles}" != *notification-* ]] || flags+=(--pm2-flag=PM2_ENABLE_NOTIFICATIONS)
  expected_ports | grep -q '^SITE_APP_PORT=' && flags+=(--pm2-flag=PM2_ENABLE_SITE)
  /usr/local/bin/node "${APP_ROOT}/scripts/native-release.mjs" pm2-apps "${flags[@]}"
}

check_native_health() {
  local names status
  names="$(expected_pm2_apps | jq -R . | jq -sc .)"
  # pm2 jlist already returns one array, so no -s/flatten. `all` over a partial list
  # passes, hence the explicit "every expected name is online" difference, and
  # unstable_restarts catches a crash loop that happens to be online right now.
  status="$(run_as_deploy /usr/local/bin/pm2 jlist 2>/dev/null)"
  jq -e --argjson want "${names}" '
    (map(select(.pm2_env.status == "online") | .name) | unique) as $online
    | length > 0
    and (($want | unique) - $online | length) == 0
    and all(.[]; (.pm2_env.unstable_restarts // 0) == 0)
  ' <<<"${status}" >/dev/null || die 'one or more PM2 services are missing, stopped, or restarting'

  # A profile turned off in .env.production would otherwise leave its process running
  # forever with rotated credentials.
  local running extra
  running="$(jq -r '.[].name' <<<"${status}")"
  while IFS= read -r extra; do
    [[ -n "${extra}" ]] || continue
    if ! expected_pm2_apps | grep -qx "${extra}"; then
      log "removing PM2 process no longer in this topology: ${extra}"
      run_as_deploy /usr/local/bin/pm2 delete "${extra}" 9>&- >/dev/null
      run_as_deploy /usr/local/bin/pm2 save 9>&- >/dev/null
    fi
  done <<<"${running}"
}

check_runtime_health() {
  if [[ "${RUNTIME_MODE}" == 'compose' ]]; then check_compose_health; else check_native_health; fi
}

doctor() {
  require_root
  load_server_environment
  validate_configuration
  require_command nginx
  require_command certbot
  local units=(nginx certbot.timer)
  if [[ "${RUNTIME_MODE}" == 'compose' ]]; then
    require_command docker
    docker info >/dev/null
    docker compose version >/dev/null
    units+=(docker nest-react-boilerplate)
  else
    require_command pm2
    units+=("$(pm2_unit_name)")
    if [[ "$(environment_value COMPOSE_DATABASE_MODE)" == 'native' ]]; then
      units+=(postgresql redis-server)
    fi
  fi
  nginx -t
  ensure_dns_resolves
  certificate_covers_domains || die 'certificate is missing, expiring within seven days, or lacks a required SAN'
  check_runtime_health
  check_loopback_bindings
  # is-active succeeds only when every named unit is active, and with no arguments it
  # would exit non-zero for the wrong reason.
  ((${#units[@]} > 0)) || die 'no runtime units were derived'
  systemctl is-active --quiet "${units[@]}"
  wait_for_https
  check_application_readiness
  log "doctor passed (${RUNTIME_MODE}): configuration, DNS, certificate, services, loopback binds, readiness, and HTTPS are healthy"
}

status() {
  require_root
  load_server_environment
  # Which runtime is live is the first thing an operator needs, and it is invisible
  # from the process list alone.
  printf 'Runtime: %s\n' "${RUNTIME_MODE}"
  printf 'Node.js: %s\n' "$(node --version 2>/dev/null || printf missing)"
  printf 'pnpm: %s\n' "$(pnpm --version 2>/dev/null || printf missing)"
  if [[ "${RUNTIME_MODE}" == 'compose' ]]; then
    printf 'Docker: %s\n' "$(docker --version 2>/dev/null || printf missing)"
    printf 'Compose: %s\n' "$(docker compose version --short 2>/dev/null || printf missing)"
    printf 'Images: %s (%s)\n' "$(environment_value IMAGE_TAG)" "${IMAGE_SOURCE}"
    systemctl --no-pager --full status docker nginx certbot.timer nest-react-boilerplate.service || true
    run_as_deploy /usr/local/bin/node "${APP_ROOT}/scripts/compose-production.mjs" ps --env-file "${PRODUCTION_ENV}" || true
  else
    printf 'PM2: %s\n' "$(pm2 --version 2>/dev/null || printf missing)"
    printf 'Commit: %s\n' "$(run_as_deploy git -C "${APP_ROOT}" rev-parse --short HEAD 2>/dev/null || printf unknown)"
    printf 'Web root: %s\n' "$(frontend_web_root)"
    systemctl --no-pager --full status nginx certbot.timer "$(pm2_unit_name)" || true
    run_as_deploy /usr/local/bin/pm2 list 9>&- || true
  fi
  local certificate="/etc/letsencrypt/live/${CERTIFICATE_NAME}/fullchain.pem"
  [[ ! -f "${certificate}" ]] || openssl x509 -in "${certificate}" -noout -subject -issuer -dates
}

logs() {
  require_root
  load_server_environment
  if [[ "${RUNTIME_MODE}" == 'compose' ]]; then
    local arguments=(logs --env-file "${PRODUCTION_ENV}" --tail=200 --follow)
    [[ -z "${LOG_SERVICE}" ]] || arguments+=("${LOG_SERVICE}")
    run_as_deploy /usr/local/bin/node "${APP_ROOT}/scripts/compose-production.mjs" "${arguments[@]}"
  else
    # PM2 process names are not Compose service names, so reject one that cannot exist
    # instead of following an empty stream.
    if [[ -n "${LOG_SERVICE}" ]] && ! expected_pm2_apps | grep -qx "${LOG_SERVICE}"; then
      die "unknown PM2 process: ${LOG_SERVICE} (available: $(expected_pm2_apps | tr '\n' ' '))"
    fi
    local pm2_arguments=(logs --lines 200)
    [[ -z "${LOG_SERVICE}" ]] || pm2_arguments=(logs "${LOG_SERVICE}" --lines 200)
    run_as_deploy /usr/local/bin/pm2 "${pm2_arguments[@]}" 9>&-
  fi
}

case "${COMMAND}" in
  init) require_root; with_lock; initialize ;;
  provision) require_root; with_lock; provision ;;
  apply) require_root; with_lock; provision; deploy ;;
  deploy) require_root; with_lock; deploy ;;
  update) require_root; with_lock; update_application ;;
  rollback) require_root; with_lock; rollback_application ;;
  renew) require_root; with_lock; renew_certificates ;;
  doctor) doctor ;;
  status) status ;;
  logs) logs ;;
  help|-h|--help) usage ;;
  *) usage >&2; die "unknown command: ${COMMAND}" ;;
esac
