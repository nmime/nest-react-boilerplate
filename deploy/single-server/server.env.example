# Host lifecycle configuration. Copy to server.env on the server; never commit
# real provider credentials. Runtime/app secrets belong in .env.production and
# its referenced secret files.

# What this host runs.
#   compose: Docker Compose images under systemd (the default). Image provenance is
#            COMPOSE_IMAGE_SOURCE in .env.production — registry pulls immutable
#            sha-<git-sha> tags, local builds them on this host.
#   native:  PM2-supervised Node processes, host PostgreSQL/Redis, and the built SPAs
#            served from disk by Nginx. No Docker is installed at all.
RUNTIME_MODE=compose

# Exact supported runtime versions. Rerunning provision upgrades only when these
# values change and keeps Node.js within the repository's >=24 <25 contract.
NODE_VERSION=24.18.0
PNPM_VERSION=11.15.1
COREPACK_VERSION=0.35.0
# Only installed for RUNTIME_MODE=native, pinned so provision is reproducible.
PM2_VERSION=6.0.13

# Deployment ownership and state locations.
DEPLOY_USER=nrb
APP_ROOT=/opt/nest-react-boilerplate
STATE_ROOT=/var/lib/nest-react-boilerplate
REPOSITORY_URL=https://github.com/nmime/nest-react-boilerplate.git
REPOSITORY_BRANCH=main

# exact-hosts: automatic HTTP-01 certificate for every enabled exact app host.
# dns-wildcard: automatic DNS-01 certificate for apex + *.PUBLIC_DOMAIN.
# existing: operator-managed certificate at /etc/letsencrypt/live/CERTIFICATE_NAME.
CERTIFICATE_MODE=exact-hosts
CERTIFICATE_NAME=example.com
CERTBOT_EMAIL=ops@example.com

# Required only for CERTIFICATE_MODE=dns-wildcard. Use a Certbot-supported DNS
# plugin name, its Debian package, and an existing root-readable credentials file.
CERTBOT_DNS_PLUGIN=cloudflare
CERTBOT_DNS_PACKAGE=python3-certbot-dns-cloudflare
CERTBOT_DNS_CREDENTIALS=/etc/letsencrypt/cloudflare.ini
CERTBOT_DNS_PROPAGATION_SECONDS=60

# Safe host maintenance defaults.
ENABLE_UFW=false
# Set the real SSH listener before enabling UFW, so reruns cannot lock you out.
SSH_PORT=22
ENABLE_UNATTENDED_UPGRADES=true
HEALTHCHECK_RETRIES=30
HEALTHCHECK_INTERVAL_SECONDS=2
# Maximum accepted request body at the public edge (Nginx size syntax).
NGINX_CLIENT_MAX_BODY_SIZE=10m
