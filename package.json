{
  "name": "nest-react-boilerplate",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "nx": "nx",
    "dev": "pnpm run dev:fullstack",
    "dev:all": "nx run-many -t serve",
    "build": "VITE_API_BASE_URL_MODE=same-origin pnpm nrb closure run build",
    "build:all": "VITE_API_BASE_URL_MODE=same-origin nx run-many -t build",
    "tooling:install": "node scripts/install-tooling-dependencies.mjs",
    "bun:check": "bun run --bun packages/tooling/bin/repo-tooling.mjs tooling bun-compat",
    "storybook": "storybook dev -p 6006 -c libs/frontend/ui-web/lib/.storybook",
    "storybook:build": "storybook build -c libs/frontend/ui-web/lib/.storybook -o dist/storybook/frontend-ui-web",
    "ui:registry:add": "pnpm --filter @repo/tooling tooling ui registry add",
    "ui:registry:search": "pnpm --filter @repo/tooling tooling ui registry search",
    "ui:shadcn:add": "pnpm --filter @repo/tooling tooling ui shadcn add",
    "test": "pnpm nrb closure run test",
    "test:all": "pnpm --filter @repo/tooling tooling qa test-aggregate",
    "test:otel": "nx run @app/backend-common-otel:test",
    "test:storybook": "pnpm --filter @repo/tooling tooling testing storybook",
    "test:visual": "pnpm --filter @repo/tooling tooling testing storybook-visual",
    "test:visual:matrix": "pnpm --filter @repo/tooling tooling testing storybook-visual --projects chromium,firefox,webkit,mobile-chrome,mobile-safari",
    "test:visual:update": "pnpm --filter @repo/tooling tooling testing storybook-visual --update-snapshots",
    "test:visual:update:matrix": "pnpm --filter @repo/tooling tooling testing storybook-visual --projects chromium,firefox,webkit,mobile-chrome,mobile-safari --update-snapshots",
    "lint": "pnpm nrb closure run lint",
    "lint:all": "nx run-many -t lint --all",
    "typecheck": "pnpm nrb closure run typecheck",
    "typecheck:all": "nx run-many -t typecheck --all",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown --cache --cache-location .cache/prettier/check-cache",
    "format:changed": "pnpm --filter @repo/tooling tooling tooling changed-format-check",
    "docs:catalog": "node scripts/generate-project-catalog.mjs",
    "docs:check": "node scripts/generate-project-catalog.mjs --check && node scripts/validate-doc-links.mjs",
    "deps:map": "pnpm --filter @repo/tooling tooling project dependency-map",
    "test:coverage": "pnpm nrb closure run test -- --coverage",
    "test:coverage:all": "pnpm --filter @repo/tooling tooling qa test-aggregate --coverage",
    "test:scripts": "node --test \"scripts/**/*.spec.mjs\"",
    "audit": "pnpm audit --audit-level=moderate",
    "audit:ci": "pnpm audit --audit-level=moderate --prod",
    "audit:full": "pnpm audit --audit-level=high",
    "audit:licenses": "node scripts/check-licenses.mjs",
    "test:component": "pnpm nrb closure run component-test",
    "test:component:all": "nx run-many -t component-test --all",
    "test:e2e": "pnpm nrb closure run e2e",
    "test:e2e:all": "nx run-many -t e2e --all --exclude fullstack-e2e",
    "test:e2e:coverage": "pnpm nrb closure run e2e -- --coverage",
    "test:e2e:coverage:all": "nx run-many -t e2e --all --exclude=fullstack-e2e -- --coverage",
    "dev:db": "pnpm nrb dev database",
    "db:migrate": "pnpm --filter @repo/tooling tooling db migrate",
    "db:migrations:check": "pnpm --filter @repo/tooling tooling db migrations check",
    "db:reset": "pnpm --filter @repo/tooling tooling db reset",
    "dev:fullstack": "pnpm --filter @repo/tooling tooling dev fullstack",
    "scaffold:verify": "node --test --test-concurrency=1 --import tsconfig-paths/register.js --import jiti/register packages/tooling/src/generators/application/generated.integration.ts",
    "agent:skills:check": "node --test packages/tooling/scripts/validate-agent-skills.spec.mjs && node packages/tooling/scripts/validate-agent-skills.mjs",
    "agent:verify": "pnpm run agent:skills:check && node packages/tooling/scripts/verify-agent-scaffolding.mjs",
    "onboarding:verify": "node scripts/validate-onboarding.mjs && pnpm run agent:verify && pnpm run scaffold:verify",
    "docker:selected": "pnpm --filter @repo/tooling tooling docker selected up --no-build",
    "docker:fullstack": "pnpm --filter @repo/tooling tooling docker selected up --no-build",
    "docker:down": "pnpm --filter @repo/tooling tooling docker selected down --remove-orphans",
    "docker:prod:init": "node scripts/compose-production-init.mjs",
    "docker:prod:config:check": "node scripts/validate-docker-compose-prod.mjs",
    "docker:prod:config": "node scripts/compose-production.mjs config",
    "docker:prod:build": "node scripts/compose-production.mjs build",
    "docker:prod:pull": "node scripts/compose-production.mjs pull",
    "docker:prod:up": "node scripts/compose-production.mjs up -d",
    "docker:prod:down": "node scripts/compose-production.mjs down",
    "docker:prod:ps": "node scripts/compose-production.mjs ps",
    "docker:prod:logs": "node scripts/compose-production.mjs logs",
    "deploy": "node scripts/deploy.mjs",
    "deploy:plan": "node scripts/deploy.mjs --dry-run",
    "deploy:validate": "node scripts/deploy-validate.mjs",
    "test:docker-smoke": "pnpm --filter @repo/tooling tooling docker smoke",
    "test:compose-deployment-modes": "node scripts/smoke-compose-database-modes.mjs",
    "bake:generate": "node scripts/generate-bake-file.mjs",
    "bake:generate:all": "node scripts/generate-bake-file.mjs --all-reference --provider postgres",
    "test:single-server-deployment": "node --test scripts/single-server-deployment.spec.mjs",
    "server:validate": "node scripts/validate-single-server-deployment.mjs",
    "server:ssh-verify": "node scripts/verify-single-server-ssh.mjs",
    "server:render-nginx": "node scripts/single-server-deployment.mjs render-nginx",
    "test:fullstack": "pnpm --filter @repo/tooling tooling docker fullstack-e2e",
    "check:fast": "pnpm run tooling:static-check && pnpm run docs:check && pnpm run i18n:catalogs:check && pnpm run spec:validate && pnpm run frontend:fsd:check && pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:coverage",
    "check": "pnpm run format:check && pnpm run tooling:static-check && pnpm run docs:check && pnpm run spec:validate && pnpm run db:migrations:check && pnpm run lib:configs:check && pnpm run frontend:fsd:check && pnpm run api:toast-config:check && pnpm run api:contracts:check && pnpm run api:clients:check && pnpm run api:openapi:lint && pnpm run api:contracts:consumer && pnpm run api:openapi:fuzz && pnpm run test:property && pnpm run test:world-class && pnpm run lint && pnpm run typecheck && pnpm run test:coverage",
    "lib:configs:check": "pnpm --filter @repo/tooling tooling project check-library-configs",
    "init:project": "pnpm --filter @repo/tooling tooling project init",
    "db:seed": "pnpm --filter @repo/tooling tooling db seed",
    "db:backup": "pnpm --filter @repo/tooling tooling db backup",
    "db:restore": "pnpm --filter @repo/tooling tooling db restore",
    "api:openapi": "pnpm --filter @repo/tooling tooling api openapi",
    "api:client": "pnpm --filter @repo/tooling tooling api client",
    "api:contracts": "pnpm --filter @repo/tooling tooling api contracts",
    "api:contracts:check": "pnpm --filter @repo/tooling tooling api contracts check",
    "api:contracts:consumer": "pnpm --filter @repo/tooling tooling qa consumer-contracts",
    "api:clients": "pnpm --filter @repo/tooling tooling api clients",
    "api:clients:check": "pnpm --filter @repo/tooling tooling api clients check",
    "api:toast-config:generate": "pnpm --filter @repo/tooling tooling api toast-config generate",
    "api:toast-config:check": "pnpm --filter @repo/tooling tooling api toast-config check",
    "api:openapi:lint": "pnpm --filter @repo/tooling tooling qa openapi-lint",
    "api:openapi:fuzz": "pnpm --filter @repo/tooling tooling qa openapi-fuzz",
    "test:a11y": "pnpm --filter @repo/tooling tooling qa accessibility",
    "test:bundle-budget": "pnpm --filter @repo/tooling tooling qa bundle-budget",
    "test:e2e:matrix": "pnpm --filter @repo/tooling tooling qa cross-browser-e2e",
    "test:perf": "pnpm --filter @repo/tooling tooling qa performance",
    "test:security:sast": "pnpm --filter @repo/tooling tooling qa security-sast",
    "test:security:secrets": "pnpm --filter @repo/tooling tooling qa secret-scan",
    "test:security:dast": "pnpm --filter @repo/tooling tooling qa security-dast",
    "test:security": "pnpm --filter @repo/tooling tooling qa security-suite",
    "security:scan": "pnpm run test:security:secrets && pnpm run test:security:sast",
    "test:mutation": "pnpm --filter @repo/tooling tooling qa mutation --tag type:common",
    "test:property": "pnpm --filter @repo/tooling tooling qa property",
    "spec:validate": "pnpm --filter @repo/tooling tooling spec validate",
    "spec:trace": "pnpm --filter @repo/tooling tooling spec trace",
    "spec:impact": "pnpm --filter @repo/tooling tooling spec impact",
    "spec:verify": "pnpm --filter @repo/tooling tooling spec verify",
    "spec:report": "pnpm --filter @repo/tooling tooling spec report",
    "test:world-class": "QA_USER_JOURNEY_COMMAND='[\"pnpm\",\"run\",\"test:fullstack\"]' QA_OBSERVABILITY_COMMAND='[\"pnpm\",\"exec\",\"nx\",\"run\",\"@app/backend-common-otel:test\"]' QA_CONCURRENCY_COMMAND='[\"pnpm\",\"exec\",\"nx\",\"run\",\"@app/backend-postgres-main-notification:component-test\"]' pnpm --filter @repo/tooling tooling qa world-class-gates",
    "test:load": "pnpm --filter @repo/tooling tooling qa world-class-gates --gate load-stress-soak",
    "test:chaos": "pnpm --filter @repo/tooling tooling qa world-class-gates --gate chaos-resilience",
    "test:disaster-recovery": "pnpm --filter @repo/tooling tooling qa world-class-gates --gate disaster-recovery",
    "test:observability": "pnpm --filter @repo/tooling tooling qa world-class-gates --gate observability",
    "test:canary": "pnpm --filter @repo/tooling tooling qa world-class-gates --gate canary-synthetic-monitoring",
    "test:concurrency": "pnpm --filter @repo/tooling tooling qa world-class-gates --gate concurrency-race",
    "test:reliability:smoke": "pnpm --filter @repo/tooling tooling qa world-class-gates --gate reliability-smoke",
    "ci:pr": "pnpm run tooling:static-check && pnpm run docs:check && pnpm run i18n:catalogs:check && pnpm run spec:validate && pnpm run format:changed && pnpm run test:security:secrets && pnpm run test:security:sast && pnpm run audit:ci",
    "quality:world-class": "pnpm run test:world-class",
    "quality:presets": "pnpm run api:openapi:lint && pnpm run api:contracts:consumer && pnpm run api:openapi:fuzz && pnpm run test:property && pnpm run test:a11y && pnpm run test:e2e:matrix && pnpm run test:perf && pnpm run test:security && pnpm run test:mutation && pnpm run test:world-class",
    "quality:visual": "pnpm run storybook:build && pnpm run test:storybook && pnpm run test:visual:matrix",
    "db:restore:drill": "pnpm --filter @repo/tooling tooling db restore-drill",
    "test:restore-drill": "pnpm run db:restore:drill -- --ci --dry-run",
    "helm:validate": "HELM_SELECTION_VALUES=.helm/values-selection.yaml bash scripts/validate-helm.sh",
    "generate:feature": "pnpm --filter @repo/tooling tooling add feature",
    "dev:mobile": "pnpm exec nx serve mobile-app",
    "mobile:web": "pnpm exec nx run mobile-app:web",
    "mobile:android": "pnpm exec nx run mobile-app:android",
    "mobile:ios": "pnpm exec nx run mobile-app:ios",
    "mobile:export": "pnpm exec nx run mobile-app:export",
    "setup": "pnpm --filter @repo/tooling tooling project setup",
    "nrb": "pnpm --filter @repo/tooling tooling",
    "tooling:static-check": "pnpm --filter @repo/tooling tooling tooling static-check",
    "images:webp": "pnpm --filter @repo/tooling tooling images webp",
    "images:webp:check": "pnpm --filter @repo/tooling tooling images webp --dry-run",
    "ci:workflows:check": "node scripts/validate-github-workflows.mjs",
    "ci:pipelines:check": "node scripts/ci/check-pipelines.mjs",
    "i18n:catalogs": "pnpm --filter @repo/tooling tooling i18n catalogs",
    "i18n:catalogs:check": "pnpm --filter @repo/tooling tooling i18n catalogs --check",
    "branch:cleanup:check": "pnpm --filter @repo/tooling tooling git branch-cleanup --target HEAD",
    "branch:cleanup": "pnpm --filter @repo/tooling tooling git branch-cleanup",
    "git:conventions": "pnpm --filter @repo/tooling tooling git conventions",
    "db:migrations:rollback-check": "pnpm --filter @repo/tooling tooling db migrations rollback-check",
    "frontend:fsd:check": "pnpm --filter @repo/tooling tooling frontend fsd check",
    "deploy:validate:docker": "node scripts/deploy-validate.mjs --mode=docker",
    "deploy:validate:docker:all-reference": "node scripts/deploy-validate.mjs --mode=docker --all-reference --provider=postgres",
    "deploy:validate:helm": "node scripts/deploy-validate.mjs --mode=helm",
    "deploy:validate:helm:all-reference": "node scripts/deploy-validate.mjs --mode=helm --all-reference --provider=postgres",
    "deploy:validate:gitops": "node scripts/deploy-validate.mjs --mode=gitops",
    "deploy:validate:pm2": "node scripts/deploy-validate.mjs --mode=pm2"
  },
