{
  "name": "mobile-app",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/frontend/mobile/src",
  "projectType": "application",
  "tags": ["platform:frontend", "type:frontend-app", "scope:user", "fsd:layer:app"],
  "// targets": "to see all targets run: nx show project mobile-app --web",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/frontend/mobile",
        "command": "EXPO_NO_TELEMETRY=1 node_modules/.bin/expo start --port 4300"
      },
      "inputs": [
        "default",
        {
          "externalDependencies": ["expo", "react-native"]
        }
      ]
    },
    "android": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/frontend/mobile",
        "command": "EXPO_NO_TELEMETRY=1 node_modules/.bin/expo run:android"
      },
      "inputs": [
        "default",
        {
          "externalDependencies": ["expo", "react-native"]
        }
      ]
    },
    "ios": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/frontend/mobile",
        "command": "EXPO_NO_TELEMETRY=1 node_modules/.bin/expo run:ios"
      },
      "inputs": [
        "default",
        {
          "externalDependencies": ["expo", "react-native"]
        }
      ]
    },
    "web": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/frontend/mobile",
        "command": "EXPO_NO_TELEMETRY=1 node_modules/.bin/expo start --web --port 4300"
      },
      "inputs": [
        "default",
        {
          "externalDependencies": ["expo", "react-native-web"]
        }
      ]
    },
    "export": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "apps/frontend/mobile",
        "command": "node scripts/export-expo.mjs --platform web"
      },
      "inputs": [
        "production",
        {
          "externalDependencies": ["@expo/metro-runtime", "expo", "react-native", "react-native-web"]
        }
      ],
      "outputs": ["{workspaceRoot}/dist/apps/frontend/mobile"]
    },
    "export-android": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "apps/frontend/mobile",
        "command": "node scripts/export-expo.mjs --platform android"
      },
      "inputs": [
        "production",
        {
          "externalDependencies": ["@expo/metro-runtime", "expo", "react-native"]
        }
      ],
      "outputs": ["{workspaceRoot}/dist/apps/frontend/mobile-android"]
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "apps/frontend/mobile",
        "command": "node ../../../node_modules/typescript/bin/tsc --noEmit --project tsconfig.app.json"
      },
      "inputs": [
        "production",
        {
          "externalDependencies": ["typescript", "expo", "react-native"]
        }
      ],
      "outputs": []
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "apps/frontend/mobile",
        "command": "node ../../../node_modules/typescript/bin/tsc --noEmit --project tsconfig.app.json"
      },
      "inputs": [
        "default",
        "^production",
        {
          "externalDependencies": ["typescript", "expo", "react-native"]
        }
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "apps/frontend/mobile",
        "command": "NODE_ENV=test vitest run --config vitest.config.mts"
      },
      "inputs": [
        "default",
        "^production",
        {
          "externalDependencies": ["vitest"]
        }
      ],
      "outputs": ["{workspaceRoot}/coverage/apps/frontend/mobile"]
    },
    "e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/frontend/mobile",
        "command": "node scripts/export-expo.mjs --platform all"
      },
      "inputs": ["production"],
      "outputs": ["{workspaceRoot}/dist/apps/frontend/mobile", "{workspaceRoot}/dist/apps/frontend/mobile-android"]
    }
  }
}
