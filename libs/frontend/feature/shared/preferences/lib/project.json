{
  "name": "@app/frontend-feature-shared-preferences",
  "$schema": "../../../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/frontend/feature/shared/preferences/lib/src",
  "projectType": "library",
  "tags": [
    "platform:frontend",
    "type:feature-shared",
    "scope:shared",
    "boundary:preferences",
    "fsd:layer:shared"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "libs/frontend/feature/shared/preferences/lib",
        "command": "node ../../../../../../node_modules/typescript/bin/tsc --noEmit --project tsconfig.lib.json"
      },
      "outputs": []
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "libs/frontend/feature/shared/preferences/lib",
        "command": "NODE_ENV=test vitest run --config vitest.config.mts"
      },
      "inputs": [
        "default",
        "^production",
        {
          "externalDependencies": [
            "vitest"
          ]
        }
      ],
      "outputs": [
        "{workspaceRoot}/coverage/libs/frontend/feature/shared/preferences"
      ]
    }
  }
}
