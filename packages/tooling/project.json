{
  "name": "@repo/tooling",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/tooling/src",
  "projectType": "library",
  "tags": ["platform:tooling", "type:tooling", "scope:repo"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": ".",
        "command": "node_modules/.bin/tsc --noEmit -p packages/tooling/tsconfig.json"
      },
      "inputs": [
        "default",
        "^production",
        {
          "externalDependencies": ["typescript"]
        }
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": ".",
        "command": "node packages/tooling/scripts/run-tests.mjs"
      },
      "inputs": [
        "default",
        "^production",
        {
          "externalDependencies": ["vitest", "typescript"]
        },
        "{workspaceRoot}/.github/workflows/**/*",
        "{workspaceRoot}/.gitlab-ci.yml",
        "{workspaceRoot}/{apps,libs}/**/project.json",
        "{workspaceRoot}/openspec/**/*",
        "{workspaceRoot}/docs/**/*.md",
        "{workspaceRoot}/nx.json"
      ]
    },
    "static-check": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": ".",
        "command": "node packages/tooling/bin/repo-tooling.mjs tooling static-check"
      },
      "inputs": [
        "default",
        "^production",
        {
          "externalDependencies": ["typescript"]
        },
        "{workspaceRoot}/.github/workflows/**/*",
        "{workspaceRoot}/.gitlab-ci.yml",
        "{workspaceRoot}/{apps,libs}/**/project.json",
        "{workspaceRoot}/openspec/**/*",
        "{workspaceRoot}/docs/**/*.md",
        "{workspaceRoot}/nx.json"
      ]
    },
    "check": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": ".",
        "command": "node_modules/.bin/tsc --noEmit -p packages/tooling/tsconfig.json && node packages/tooling/bin/repo-tooling.mjs tooling static-check"
      },
      "inputs": [
        "default",
        "^production",
        {
          "externalDependencies": ["typescript"]
        }
      ]
    }
  }
}
