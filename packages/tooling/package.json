{
  "name": "@repo/tooling",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Reusable TS-first repo tooling commands for API contracts, database operations, Docker, testing, QA presets, and repository checks.",
  "bin": {
    "repo-tooling": "./bin/repo-tooling.mjs"
  },
  "scripts": {
    "tooling": "node ./bin/repo-tooling.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "static-check": "node ./bin/repo-tooling.mjs tooling static-check",
    "check": "pnpm run typecheck && pnpm run static-check"
  },
  "files": [
    "bin",
    "src",
    "config",
    "baselines",
    "README.md",
    "tsconfig.json"
  ],
  "dependencies": {
    "@mikro-orm/core": "7.1.5",
    "@playwright/test": "1.61.1",
    "@swc-node/register": "1.11.1",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-report": "3.0.1",
    "istanbul-reports": "3.2.0",
    "jiti": "2.7.0",
    "pg": "8.22.0",
    "sharp": "0.35.3",
    "tsconfig-paths": "4.2.0"
  },
  "exports": {
    ".": "./src/cli.ts",
    "./commands/*": "./src/commands/*.ts",
    "./runtime/*": "./src/runtime/*.ts",
    "./package.json": "./package.json"
  }
}
