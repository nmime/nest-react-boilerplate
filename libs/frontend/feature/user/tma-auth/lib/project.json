{
  "name": "@app/frontend-feature-user-tma-auth",
  "$schema": "../../../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/frontend/feature/user/tma-auth/lib/src",
  "projectType": "library",
  "tags": ["platform:frontend", "type:feature-shared", "scope:user", "boundary:tma-auth", "fsd:layer:shared"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "libs/frontend/feature/user/tma-auth/lib",
        "command": "node ../../../../../../node_modules/typescript/bin/tsc --noEmit --project tsconfig.lib.json"
      },
      "outputs": []
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "libs/frontend/feature/user/tma-auth/lib",
        "command": "NODE_ENV=test vitest run --config vitest.config.mts"
      },
      "inputs": [
        "default",
        "^production",
        {
          "externalDependencies": ["vitest"]
        }
      ],
      "outputs": ["{workspaceRoot}/coverage/libs/frontend/feature/user/tma-auth"]
    }
  }
}
