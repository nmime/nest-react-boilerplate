# Environment example
# Copy to .env (or .env.local for local development) and replace placeholders.
# Do not commit real secrets, tokens, private keys, or production .env files.

# --- Product identity ---------------------------------------------------
# The values below still carry this boilerplate's own identity. A product
# built from this repository MUST replace them; see docs/product-identity.md
# for the full surface, the `nrb init` rename path, and the residue gate.
#
# Identity-derived variables in this file:
#   ANALYTICS_APP_NAME, APP_NAME, BACKUP_PREFIX, COMPOSE_PROJECT_NAME,
#   CONTAINER_DATABASE_URL, DOCKER_DATABASE_URL, HELM_RELEASE_NAME,
#   IMAGE_REGISTRY, MONGODB_APP_NAME, MONGODB_DATABASE, MONGODB_URI,
#   MONGODB_USER, NATS_NAME, OPENAPI_TITLE, POSTGRES_DB,
#   QA_CANARY_USER_AGENT, S3_BUCKET
#
# BACKUP_PREFIX and S3_BUCKET name a storage namespace. Left at the boilerplate
# default, this environment writes into another project's namespace.
# ------------------------------------------------------------------------
# .env.example and .env.local.example intentionally keep identical active key order.
# Profile: shared/production-like defaults

# Runtime identity
# Required/optional runtime setting; replace placeholders per environment.
APP_NAME=nest-react-boilerplate
# Optional QA/workflow override.
CI=false
# Required/optional runtime setting; replace placeholders per environment.
CONTAINER=
# Required/optional runtime setting; replace placeholders per environment.
GRACEFUL_SHUTDOWN=true
# Required/optional runtime setting; replace placeholders per environment.
HOST=0.0.0.0
# Required/optional runtime setting; replace placeholders per environment.
KUBERNETES_SERVICE_HOST=
# Required/optional runtime setting; replace placeholders per environment.
LOGGER_FORMAT=json
# Required/optional runtime setting; replace placeholders per environment.
LOG_FORMAT=json
# Required/optional runtime setting; replace placeholders per environment.
LOG_LEVEL=info
# Required/optional runtime setting; replace placeholders per environment.
NODE_ENV=production
# Global PORT is intentionally unset; use service-specific assignments below.
PORT=

# API ports and browser origins
# Required/optional runtime setting; replace placeholders per environment.
ADMIN_APP_API_PORT=3001
# Required/optional runtime setting; replace placeholders per environment.
ADMIN_APP_PORT=4200
# Required/optional runtime setting; replace placeholders per environment.
AUTH_APP_API_PORT=3003
# Explicit ports for bot-facing APIs and worker.
DISCORD_APP_API_PORT=3007
TELEGRAM_BOT_API_PORT=3013
# Required/optional runtime setting; replace placeholders per environment.
CORS_ORIGINS=https://admin-app.example.com,https://user-app.example.com,https://example.com,https://site-app.example.com,https://mobile-app.example.com
# Required/optional runtime setting; replace placeholders per environment.
FULLSTACK_BASE_URL=
# Required/optional runtime setting; replace placeholders per environment.
FULLSTACK_HOST=127.0.0.1
# Required/optional runtime setting; replace placeholders per environment.
LANDING_APP_PORT=4202
# Required/optional runtime setting; replace placeholders per environment.
MOBILE_APP_PORT=4300
# Required/optional runtime setting; replace placeholders per environment.
SITE_APP_PORT=4203
# Required/optional runtime setting; replace placeholders per environment.
TRUST_PROXY=false
# Required/optional runtime setting; replace placeholders per environment.
USER_APP_API_PORT=3002
# Required/optional runtime setting; replace placeholders per environment.
USER_APP_PORT=4201
# Required/optional runtime setting; replace placeholders per environment.
USER_APP_URL=

# Session cookies
# Required/optional runtime setting; replace placeholders per environment.
SESSION_COOKIE_MAX_AGE_SECONDS=604800
# Required/optional runtime setting; replace placeholders per environment.
SESSION_COOKIE_NAME=__Host-nrb.sid
# Required/optional runtime setting; replace placeholders per environment.
SESSION_COOKIE_SAME_SITE=lax
# Required/optional runtime setting; replace placeholders per environment.
SESSION_COOKIE_SECURE=true
# Required/secret placeholder when enabled; never commit a real value.
SESSION_SECRET=
BETTER_AUTH_SECRET=<set-better-auth-secret-min-32-chars>
BETTER_AUTH_SECRET_FILE=
BETTER_AUTH_URL=https://auth-app-api.example.com
BETTER_AUTH_TRUSTED_ORIGINS=https://user-app.example.com,https://example.com
AUTH_ALLOWED_RETURN_URLS=https://admin-app.example.com,https://user-app.example.com,https://example.com,https://site-app.example.com,https://mobile-app.example.com

# Auth, RBAC, and token cleanup
# Required/optional runtime setting; replace placeholders per environment.
ADMIN_BOOTSTRAP_EMAILS=admin@example.com
# Required/optional runtime setting; replace placeholders per environment.
ADMIN_BOOTSTRAP_ENABLED=false
# Required/optional runtime setting; replace placeholders per environment.
ADMIN_BOOTSTRAP_TENANT_IDS=
# Demo mode: serve every request as a synthetic principal with no login at all.
# `false` everywhere except a throwaway MVP/demo deployment. See docs/environment-variables.md.
AUTH_DEMO_MODE=false
# AUTH_DEMO_ROLES=user,admin
# AUTH_DEMO_SUBJECT=11111111-1111-1111-1111-111111111111
# AUTH_DEMO_TENANT_ID=00000000-0000-0000-0000-000000000000
# AUTH_DEMO_EMAIL=demo@example.invalid
# AUTH_DEMO_DISPLAY_NAME=Demo User
# Required/optional runtime setting; replace placeholders per environment.
AUTH_PERSISTENCE=postgres
AUTH_GEOIP_DATABASE_PATH=
AUTH_LOGIN_NETWORK_RETENTION_DAYS=30
AUTH_LOGIN_EVENT_RETENTION_DAYS=365
AUTH_LOGIN_ANALYTICS_IP_HASH_SECRET=
# Required/optional runtime setting; replace placeholders per environment.
AUTH_TOKEN_CLEANUP_ENABLED=true
# Required/optional runtime setting; replace placeholders per environment.
AUTH_TOKEN_CLEANUP_INTERVAL_MS=3600000
# Required/optional runtime setting; replace placeholders per environment.
AUTH_TOKEN_CLEANUP_RUN_ON_START=true

# Social auth, Telegram Mini App, bots, and Discord
# Optional social-auth policy; enable only after provider runtime is implemented and configured.
EXTERNAL_AUTH_AUTO_PROVISION_ENABLED=false
# Optional social-auth policy; maximum age for step-up confirmation before link/unlink.
EXTERNAL_AUTH_STEP_UP_MAX_AGE_SECONDS=900
# Optional social-auth policy; signed link-token lifetime.
EXTERNAL_AUTH_LINK_TOKEN_TTL_SECONDS=600
# Optional social-auth policy; OAuth/TMA state lifetime.
EXTERNAL_AUTH_STATE_TTL_SECONDS=600
# Required/secret placeholder when provider refresh/access tokens are stored.
AUTH_PROVIDER_TOKEN_ENCRYPTION_KEY=<set-32-byte-base64-key>
# Prod-only secret-file path for Docker/Compose secret mounting.
AUTH_PROVIDER_TOKEN_ENCRYPTION_KEY_FILE=
# Store provider tokens only when encryption is explicitly enabled.
AUTH_PROVIDER_TOKEN_ENCRYPTION_ENABLED=false
# Optional provider encryption key identifier for rotation.
AUTH_PROVIDER_TOKEN_ENCRYPTION_KEY_ID=primary
# Optional Telegram social auth/TMA setting.
AUTH_TELEGRAM_ENABLED=false
# Optional Telegram auth bot username without @.
TELEGRAM_AUTH_BOT_USERNAME=example_bot
# Optional Telegram init-data max age.
TELEGRAM_TMA_MAX_AGE_SECONDS=300
# Optional Telegram replay-cache TTL.
TELEGRAM_AUTH_REPLAY_TTL_SECONDS=900
# Required/secret placeholder when Telegram bot/social auth is enabled.
TELEGRAM_BOT_TOKEN=<set-telegram-bot-token>
# Prod-only secret-file path for Docker/Compose secret mounting.
TELEGRAM_BOT_TOKEN_FILE=
TELEGRAM_OIDC_ENABLED=false
# The Telegram OIDC provider stays disabled until BOTH client credentials are
# set; a placeholder client ID alone would auto-enable it with a fake secret.
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
TELEGRAM_OIDC_CLIENT_SECRET_FILE=
TELEGRAM_OIDC_SCOPES=openid profile
# Advanced Telegram OIDC endpoint overrides; leave empty for discovery defaults.
TELEGRAM_OIDC_DISCOVERY_URL=
TELEGRAM_OIDC_ISSUER=
TELEGRAM_OIDC_JWKS_URL=
# Optional Telegram bot username without @.
TELEGRAM_BOT_USERNAME=example_bot
# Optional Telegram bot webhook secret token when webhook mode is enabled.
TELEGRAM_BOT_WEBHOOK_SECRET=<set-telegram-webhook-secret>
# Prod-only secret-file path for Docker/Compose secret mounting.
TELEGRAM_BOT_WEBHOOK_SECRET_FILE=
# Optional Telegram bot runtime mode: webhook or polling.
TELEGRAM_BOT_MODE=webhook
# Optional Telegram bot webhook URL.
TELEGRAM_BOT_WEBHOOK_URL=https://telegram-bot-api.example.com/telegram/webhook
# Optional Telegram Mini App/Open App frontend URL. Use an HTTPS user frontend route, not an API/webhook URL.
# Configure the same value in BotFather as the Mini App/Web App URL.
# Canonical Telegram Mini App/Open App frontend URL consumed by the bot.
TELEGRAM_MINI_APP_URL=https://user-app.example.com/telegram-mini-app
# Optional Telegram account-link token TTL.
# Publish localized private-chat commands and the persistent Mini App menu button; disable only for isolated tests.
TELEGRAM_BOT_MENU_BUTTON_ENABLED=true
TELEGRAM_LINK_TOKEN_TTL_SECONDS=600
# Optional Discord OAuth/social auth setting.
DISCORD_AUTH_ENABLED=false
# Optional Discord OAuth application/client id.
DISCORD_CLIENT_ID=example-discord-client-id
# Discord application id used by the interactions API; commonly the same value
# as DISCORD_CLIENT_ID, but explicit so the runtime contract is unambiguous.
DISCORD_APPLICATION_ID=example-discord-application-id
# Required/secret placeholder when Discord OAuth is enabled.
DISCORD_CLIENT_SECRET=<set-discord-client-secret>
# Prod-only secret-file path for Docker/Compose secret mounting.
DISCORD_CLIENT_SECRET_FILE=
# Optional Discord OAuth redirect URI.
DISCORD_REDIRECT_URI=https://auth-app-api.example.com/auth/discord/callback
# Optional Discord OAuth scopes.
DISCORD_SCOPES=identify email guilds.join
# Optional Discord OAuth state TTL in seconds; defaults to 600 when unset.
DISCORD_OAUTH_STATE_TTL_SECONDS=600
# Optional Discord OAuth state entry cap; defaults to 10000 when unset.
DISCORD_OAUTH_STATE_MAX_ENTRIES=10000
# Required/secret placeholder when the Discord bot is enabled.
DISCORD_BOT_TOKEN=<set-discord-bot-token>
# Prod-only secret-file path for Docker/Compose secret mounting.
DISCORD_BOT_TOKEN_FILE=
# Optional Discord interactions public key for signature verification.
DISCORD_PUBLIC_KEY=<set-discord-public-key>
# Prod-only public-key file path for Docker/Compose mounting.
DISCORD_PUBLIC_KEY_FILE=
# Optional Discord command registration toggle.
DISCORD_COMMAND_REGISTRATION_ENABLED=false
# Optional Discord interactions endpoint URL.
DISCORD_INTERACTIONS_ENDPOINT=https://discord-app-api.example.com/discord/interactions
# Optional Discord interactions state TTL.
DISCORD_INTERACTIONS_STATE_TTL_SECONDS=600

# Notification providers. Select the custom-auth route with telegram-bot,
# discord-bot, resend, or mailpace. Better Auth links always use the selected email provider.
AUTH_NOTIFICATION_PROVIDER=resend
NOTIFICATION_EMAIL_PROVIDER=resend
NOTIFICATION_EMAIL_FROM=Example <no-reply@example.com>
# Required whenever notifications are enabled: exactly 32 bytes, as base64 or 64 hex characters.
NOTIFICATION_PAYLOAD_ENCRYPTION_KEY=<set-32-byte-notification-payload-key>
NOTIFICATION_PAYLOAD_ENCRYPTION_KEY_FILE=
NOTIFICATION_PAYLOAD_ENCRYPTION_KEY_ID=primary
RESEND_API_KEY=<set-resend-api-key>
RESEND_API_KEY_FILE=
MAILPACE_SERVER_TOKEN=<set-mailpace-server-token>
MAILPACE_SERVER_TOKEN_FILE=
NOTIFICATION_DELIVERIES_PER_ITERATION=50
NOTIFICATION_REQUESTS_PER_SECOND=30
NOTIFICATION_DELIVERIES_PARTITION_AHEAD_MONTHS=6
NOTIFICATION_BROADCAST_REQUIRE_INDEPENDENT_APPROVAL=false
NOTIFICATION_CONSUMER_INTERVAL_MS=1000
NOTIFICATION_MATERIALIZATION_CHUNK_SIZE=500
NOTIFICATION_CSV_MAX_BYTES=10485760
NOTIFICATION_CSV_MAX_ROWS=100000
# Google FCM HTTP v1 service-account settings for push delivery.
NOTIFICATION_FCM_PROJECT_ID=
NOTIFICATION_FCM_CLIENT_EMAIL=
NOTIFICATION_FCM_PRIVATE_KEY=
NOTIFICATION_FCM_PRIVATE_KEY_FILE=
NOTIFICATION_FCM_TOKEN_URI=https://oauth2.googleapis.com/token
# Apple APNs token-auth settings for push delivery.
NOTIFICATION_APNS_TEAM_ID=
NOTIFICATION_APNS_KEY_ID=
NOTIFICATION_APNS_BUNDLE_ID=
NOTIFICATION_APNS_PRIVATE_KEY=
NOTIFICATION_APNS_PRIVATE_KEY_FILE=
NOTIFICATION_APNS_SANDBOX=false

# OAuth / OIDC
# Optional integration setting; enable only with matching infrastructure.
AUTH_OAUTH_CLIENT_ID=example-client-id
# Required/secret placeholder when enabled; never commit a real value.
AUTH_OAUTH_CLIENT_SECRET=<set-oauth-client-secret>
# Optional integration setting; enable only with matching infrastructure.
AUTH_OAUTH_ENABLED=false
# Optional integration setting; enable only with matching infrastructure.
AUTH_OAUTH_ISSUER_URL=https://issuer.example.com/
# Optional integration setting; enable only with matching infrastructure.
AUTH_OAUTH_REDIRECT_URI=https://auth-app-api.example.com/oauth/callback
# Optional integration setting; enable only with matching infrastructure.
AUTH_OAUTH_SCOPES=openid profile email

# Analytics
# Optional integration setting; enable only with matching infrastructure.
ANALYTICS_APP_NAME=nest-react-boilerplate-api
# Optional integration setting; enable only with matching infrastructure.
ANALYTICS_ENABLED=false
# Optional integration setting; enable only with matching infrastructure.
ANALYTICS_ENVIRONMENT=production
# Required/secret placeholder when enabled; never commit a real value.
ANALYTICS_GA4_API_SECRET=
# Optional integration setting; enable only with matching infrastructure.
ANALYTICS_GA4_COLLECT_URL=https://www.google-analytics.com/mp/collect
# Optional integration setting; enable only with matching infrastructure.
ANALYTICS_GA4_MEASUREMENT_ID=
# Required/secret placeholder when enabled; never commit a real value.
ANALYTICS_POSTHOG_API_KEY=
# Optional integration setting; enable only with matching infrastructure.
ANALYTICS_POSTHOG_HOST=https://app.posthog.com
# Optional integration setting; enable only with matching infrastructure.
ANALYTICS_PROVIDER=noop
# Optional integration setting; enable only with matching infrastructure.
ANALYTICS_PROVIDERS=
# Optional integration setting; enable only with matching infrastructure.
ANALYTICS_UMAMI_ENDPOINT=
# Optional integration setting; enable only with matching infrastructure.
ANALYTICS_UMAMI_HOST=
# Optional integration setting; enable only with matching infrastructure.
ANALYTICS_UMAMI_HOSTNAME=user-app-api.example.com
# Optional integration setting; enable only with matching infrastructure.
ANALYTICS_UMAMI_WEBSITE_ID=

# Redis (caching and rate limiting)
# Optional integration setting; enable only with matching infrastructure.
RATE_LIMIT_ENABLED=true
# Optional integration setting; enable only with matching infrastructure.
RATE_LIMIT_IN_MEMORY_ALLOWED=false
# Optional integration setting; enable only with matching infrastructure.
RATE_LIMIT_MAX=100
# Optional integration setting; enable only with matching infrastructure.
RATE_LIMIT_STORE=redis
# Optional integration setting; enable only with matching infrastructure.
RATE_LIMIT_WINDOW_MS=60000
# Optional integration setting; enable only with matching infrastructure.
REDIS_DB=0
# Optional integration setting; enable only with matching infrastructure.
REDIS_HOSTS=
# Optional integration setting; enable only with matching infrastructure.
REDIS_KEY_PREFIX=nrb:
# Connect only when the selected application actually uses Redis.
REDIS_LAZY_CONNECT=true
# Optional integration setting; enable only with matching infrastructure.
REDIS_MODE=single
# Required/secret placeholder when enabled; never commit a real value.
REDIS_PASSWORD=
# Optional Docker/Compose port override.
REDIS_PORT=6379
# Optional integration setting; enable only with matching infrastructure.
REDIS_SENTINEL_GROUP_IDENTIFIER=
# Optional integration setting; enable only with matching infrastructure.
REDIS_URL=redis://redis:6379/0

# NATS messaging
# Optional integration setting; enable only with matching infrastructure.
NATS_DRAIN_TIMEOUT_MS=5000
# Optional integration setting; enable only with matching infrastructure.
NATS_MAX_RECONNECT_ATTEMPTS=10
# Optional integration setting; enable only with matching infrastructure.
NATS_NAME=nest-react-boilerplate-api
# Required/secret placeholder when enabled; never commit a real value.
NATS_PASS=
# Token authentication is mutually exclusive with NATS_USER/NATS_PASS.
NATS_TOKEN=
# Optional integration setting; enable only with matching infrastructure.
NATS_PING_INTERVAL_MS=120000
# Optional integration setting; enable only with matching infrastructure.
NATS_RECONNECT=true
# Optional integration setting; enable only with matching infrastructure.
NATS_RECONNECT_TIME_WAIT_MS=2000
# Optional integration setting; enable only with matching infrastructure.
NATS_SERVERS=
# Optional Docker/Compose port override.
NATS_MONITOR_PORT=8222
# Optional Docker/Compose port override.
NATS_PORT=4222
# Optional integration setting; enable only with matching infrastructure.
NATS_TIMEOUT_MS=2000
# Optional integration setting; enable only with matching infrastructure.
NATS_USER=
# Optional integration setting; enable only with matching infrastructure.
NATS_WAIT_ON_FIRST_CONNECT=false

# MinIO (S3-compatible object storage)
# Optional integration setting; enable only with matching infrastructure.
S3_ACCESS_KEY=minioadmin
# Required/secret placeholder when enabled; never commit a real value.
S3_SECRET_KEY=minioadmin
# Optional integration setting; enable only with matching infrastructure.
S3_ENDPOINT=http://minio:9000
# Optional integration setting; enable only with matching infrastructure.
S3_BUCKET=nest-react-boilerplate
# Optional integration setting; enable only with matching infrastructure.
S3_REGION=us-east-1
# Optional integration setting; enable only with matching infrastructure.
S3_FORCE_PATH_STYLE=true
# Optional Docker/Compose port override.
MINIO_PORT=9000
# Optional Docker/Compose port override.
MINIO_CONSOLE_PORT=9001
# Required/secret placeholder when enabled; never commit a real value.
MINIO_ROOT_USER=minioadmin
# Required/secret placeholder when enabled; never commit a real value.
MINIO_ROOT_PASSWORD=minioadmin
# Optional static-data capability root inside the application/container.
STATIC_DATA_ROOT=data

# OpenAPI and API contracts
# Required/optional runtime setting; replace placeholders per environment.
API_CONTRACTS_WORKSPACE_ROOT=.
# Required/optional runtime setting; replace placeholders per environment.
CONSUMER_CONTRACTS_ROOT=contracts/consumer
# Optional integration setting; enable only with matching infrastructure.
OPENAPI_ALLOW_PRODUCTION=false
# Optional integration setting; enable only with matching infrastructure.
OPENAPI_CONTRACTS_ROOT=apps/backend
# Optional integration setting; enable only with matching infrastructure.
OPENAPI_DESCRIPTION=
# Optional integration setting; enable only with matching infrastructure.
OPENAPI_ENABLED=false
# Optional integration setting; enable only with matching infrastructure.
OPENAPI_FUZZ_ENGINE=schemathesis
# Optional integration setting; enable only with matching infrastructure.
OPENAPI_FUZZ_MAX_EXAMPLES=25
# Optional integration setting; enable only with matching infrastructure.
OPENAPI_FUZZ_TIMEOUT_MS=30000
# Optional integration setting; enable only with matching infrastructure.
OPENAPI_FUZZ_UNSAFE=false
# Optional integration setting; enable only with matching infrastructure.
OPENAPI_LINT_ENGINE=spectral
# Optional integration setting; enable only with matching infrastructure.
OPENAPI_PATH=docs
# Optional integration setting; enable only with matching infrastructure.
OPENAPI_TITLE=Nest React Boilerplate API
# Optional integration setting; enable only with matching infrastructure.
OPENAPI_VERSION=1.0.0
# Required/optional runtime setting; replace placeholders per environment.
SPECTRAL_CLI_VERSION=6.15.0

# OpenTelemetry
# Optional integration setting; enable only with matching infrastructure.
OTEL_ENABLED=false
# Optional integration setting; enable only with matching infrastructure.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# Required/secret placeholder when enabled; never commit a real value.
OTEL_EXPORTER_OTLP_HEADERS=
# Optional integration setting; enable only with matching infrastructure.
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
# Optional signal-specific headers override the shared OTLP headers.
OTEL_EXPORTER_OTLP_METRICS_HEADERS=
# Optional integration setting; enable only with matching infrastructure.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_HEADERS=
# Optional integration setting; enable only with matching infrastructure.
OTEL_METRIC_EXPORT_INTERVAL=60000
# Optional integration setting; enable only with matching infrastructure.
OTEL_SDK_DISABLED=false
# Optional integration setting; enable only with matching infrastructure.
OTEL_SERVICE_VERSION=1.0.0

# Durable database provider (PostgreSQL remains the default).
DATABASE_ENGINE=postgres
MONGODB_URI=mongodb://mongodb.localhost:27017/nest_react_boilerplate?replicaSet=rs0&retryWrites=true
MONGODB_URI_FILE=
MONGODB_DATABASE=nest_react_boilerplate
MONGODB_REPLICA_SET=rs0
MONGODB_APP_NAME=nest-react-boilerplate
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_MIN_POOL_SIZE=0
MONGODB_MAX_POOL_SIZE=20
MONGODB_PORT=27017
MONGODB_USER=nest_react_boilerplate
MONGODB_ROOT_USER=nrb_root
MONGODB_ROOT_PASSWORD_FILE=
MONGODB_PASSWORD_FILE=
MONGODB_KEYFILE_FILE=
MONGODB_DATABASE_TOOLS_USE_DOCKER=false

# PostgreSQL and MikroORM
# Required/optional runtime setting; replace placeholders per environment.
CONTAINER_DATABASE_URL=postgres://postgres:postgres@postgres:5432/nest_react_boilerplate
# Required/optional runtime setting; replace placeholders per environment.
DATABASE_URL=
# Optional Docker/Compose/build/deploy setting.
DOCKER_DATABASE_URL=postgres://postgres:postgres@postgres:5432/nest_react_boilerplate
# Optional backup/restore setting.
POSTGRES_CLIENT_DOCKER_IMAGE=postgres:18-alpine
# Required/optional runtime setting; replace placeholders per environment.
POSTGRES_DB=nest_react_boilerplate
# Required/optional runtime setting; replace placeholders per environment.
POSTGRES_HOST=localhost
# Required/optional runtime setting; replace placeholders per environment.
POSTGRES_LOGGING=false
# Runtime schema defaults; tune only after measuring the target database.
POSTGRES_POOL_IDLE_TIMEOUT_MS=30000
POSTGRES_POOL_MAX=10
POSTGRES_POOL_MIN=2
POSTGRES_SLOW_QUERY_MS=
POSTGRES_SYNCHRONIZE=false
# Required/secret placeholder when enabled; never commit a real value.
POSTGRES_PASSWORD=postgres
# Prod-only secret-file path for Docker/Compose secret mounting.
POSTGRES_PASSWORD_FILE=
# Required/optional runtime setting; replace placeholders per environment.
POSTGRES_PORT=5432
# Required/optional runtime setting; replace placeholders per environment.
POSTGRES_SSL=false
# Required/optional runtime setting; replace placeholders per environment.
POSTGRES_SSL_REJECT_UNAUTHORIZED=true
# Required/optional runtime setting; replace placeholders per environment.
POSTGRES_USER=postgres

# Frontend builds
# Development/test may leave VITE_API_BASE_URL_MODE empty and use the explicit
# placeholder API origins below. Direct production frontend build targets default
# to same-origin only when no API mode or API origins are configured. Production
# split-origin builds should set all VITE_*_API_BASE_URL values to explicit
# public origins and may set VITE_API_BASE_URL_MODE=split-origin.
# See docs/frontend-deployment-topology.md.
# Required/optional runtime setting; replace placeholders per environment.
VITE_ADMIN_API_BASE_URL=https://admin-app-api.example.com
# Same-origin API proxy mode uses empty generated client roots at build time.
# Leave empty for local split-origin development; set same-origin explicitly for
# production same-origin/path-based frontend deployments.
VITE_API_BASE_URL_MODE=
# Required/optional runtime setting; replace placeholders per environment.
VITE_AUTH_API_BASE_URL=https://auth-app-api.example.com
VITE_TELEGRAM_AUTH_ENABLED=false
# Product identity. Build-time defaults baked into the SPA image; the matching
# PRODUCT_* container variables override them per deployment so one image can
# serve several brands. Leave unset to keep the boilerplate identity.
VITE_PRODUCT_NAME=
VITE_PRODUCT_ICON_HREF=
VITE_PRODUCT_ICON_TYPE=
VITE_PRODUCT_THEME_COLOR=
# Chrome an embedding host paints for us (the Telegram mini app). It sits outside
# the document, so no stylesheet reaches it; leave unset to keep the design tokens.
VITE_PRODUCT_CHROME_BACKGROUND_COLOR=
VITE_PRODUCT_CHROME_BOTTOM_BAR_COLOR=
VITE_PRODUCT_CHROME_HEADER_COLOR=
# Per-deployment product identity written into /runtime-config.js at container
# start. A value that is not a plain string, a public icon URL/path, an
# image/* media type, or a #rgb/#rrggbb colour is ignored.
PRODUCT_NAME=
PRODUCT_ICON_HREF=
PRODUCT_ICON_TYPE=
PRODUCT_THEME_COLOR=
PRODUCT_CHROME_BACKGROUND_COLOR=
PRODUCT_CHROME_BOTTOM_BAR_COLOR=
PRODUCT_CHROME_HEADER_COLOR=
# Required/optional runtime setting; replace placeholders per environment.
VITE_E2E_COVERAGE=false
# Required/optional runtime setting; replace placeholders per environment.
VITE_USER_API_BASE_URL=https://user-app-api.example.com

# Docker, Compose, images, Helm
# Optional Docker/Compose/build/deploy setting.
BUILD_OUTPUT=dist/apps/backend/admin/admin-app-api
# Optional Docker/Compose/build/deploy setting.
COMPOSE_BAKE=false
# Optional Docker/Compose/build/deploy setting.
COMPOSE_PARALLEL_LIMIT=4
# Optional Docker/Compose/build/deploy setting.
COMPOSE_PROJECT_NAME=nest-react-boilerplate
# Optional Docker/Compose/build/deploy setting.
DOCKER_BACKEND_HOST=127.0.0.1
# Optional Docker/Compose/build/deploy setting.
DOCKER_BUILDKIT=1
# Optional Docker/Compose/build/deploy setting.
DOCKER_BUILD_NETWORK=default
# Optional Docker/Compose/build/deploy setting.
DOCKER_SMOKE_HOST=127.0.0.1
# Optional Docker/Compose/build/deploy setting.
DOCKER_TEST_PORT_BASE=
# Optional Docker/Compose/build/deploy setting.
FRONTEND_OUTPUT=dist/apps/frontend/admin
# Optional Docker/Compose/build/deploy setting.
HELM_NAMESPACE=default
# Optional Docker/Compose/build/deploy setting.
HELM_RELEASE_NAME=nest-react-boilerplate
# Optional Docker/Compose/build/deploy setting.
IMAGE_REGISTRY=ghcr.io/your-github-org/nest-react-boilerplate
# Optional Docker/Compose/build/deploy setting.
IMAGE_TAG=sha-000000000000
# Optional Docker/Compose/build/deploy setting.
NODE_VERSION=24.18.0-alpine
# Optional Docker/Compose/build/deploy setting.
NX_PROJECT=
# Optional Docker/Compose/build/deploy setting.
PNPM_VERSION=11.15.1

# Backups and restore drills
# Optional backup/restore setting.
BACKUP_BUCKET=
# Optional backup/restore setting.
BACKUP_ENCRYPTION_COMMAND=
# Optional backup/restore setting.
BACKUP_ENCRYPTION_ENABLED=false
# Optional backup/restore setting.
BACKUP_PATH=/backups
# Optional backup/restore setting.
BACKUP_PREFIX=nest-react-boilerplate/postgres
# Optional backup/restore setting.
BACKUP_RETENTION_COMMAND=
# Optional backup/restore setting.
BACKUP_RETENTION_KEEP_LAST=168
# Optional backup/restore setting.
BACKUP_UPLOAD_COMMAND=
# Optional backup/restore setting.
DB_BACKUP_DOCKER_IMAGE=postgres:18-alpine
# Optional backup/restore setting.
DB_BACKUP_USE_DOCKER=false
# Optional backup/restore setting.
POST_BACKUP_HOOK=
# Optional backup/restore setting.
PRE_BACKUP_HOOK=

# QA, workflows, and deploy validation
