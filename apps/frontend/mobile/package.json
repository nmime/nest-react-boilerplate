{
  "name": "mobile-app",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "android": "EXPO_NO_TELEMETRY=1 expo run:android",
    "ios": "EXPO_NO_TELEMETRY=1 expo run:ios",
    "start": "EXPO_NO_TELEMETRY=1 expo start --port 4300",
    "web": "EXPO_NO_TELEMETRY=1 expo start --web --port 4300",
    "export:web": "EXPO_NO_TELEMETRY=1 expo export --platform web --output-dir ../../../dist/apps/frontend/mobile"
  },
  "dependencies": {
    "@expo/log-box": "57.0.1",
    "@expo/metro-runtime": "57.0.5",
    "expo": "57.0.6",
    "expo-constants": "57.0.5",
    "expo-linking": "57.0.3",
    "expo-router": "57.0.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "3.0.2",
    "react-native-reanimated": "4.5.2",
    "react-native-safe-area-context": "5.8.0",
    "react-native-screens": "4.26.2",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.2"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@nx/vite": "23.1.0",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.17",
    "babel-preset-expo": "57.0.3",
    "happy-dom": "20.10.6",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
