{
  "name": "@repo/tooling",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/tooling/src",
  "projectType": "library",
  "tags": ["platform:tooling", "type:tooling", "scope:repo"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": ".",
        "command": "node_modules/.bin/tsc --noEmit -p packages/tooling/tsconfig.json"
      },
      "inputs": [
        "default",
        "^production",
        {
          "externalDependencies": ["typescript"]
        }
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": ".",
        "command": "node --test --import jiti/register \"packages/tooling/src/**/*.test.ts\""
      },
      "inputs": ["default"]
    },
    "static-check": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": ".",
        "command": "node packages/tooling/bin/repo-tooling.mjs tooling static-check"
      },
      "inputs": [
        "default",
        "^production",
        {
          "externalDependencies": ["typescript"]
        }
      ]
    },
    "check": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": ".",
        "command": "node_modules/.bin/tsc --noEmit -p packages/tooling/tsconfig.json && node packages/tooling/bin/repo-tooling.mjs tooling static-check"
      },
      "inputs": [
        "default",
        "^production",
        {
          "externalDependencies": ["typescript"]
        }
      ]
    }
  }
}
