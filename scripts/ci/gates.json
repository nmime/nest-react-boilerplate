{
  "$comment": "Forge-neutral CI gate inventory. Both .github/workflows and .gitlab-ci.yml render it, and node scripts/ci/check-pipelines.mjs verifies every configured forge against it. Add a gate here first, then wire it into every forge; a forge that cannot run a gate must say so with `forges` plus `reason`. See docs/ci-lanes.md.",
  "forges": {
    "github": {
      "pipeline": ".github/workflows/ci.yml",
      "jobStyle": "github",
      "aggregateJob": "ci-status-summary",
      "releasePipeline": ".github/workflows/release-images.yml",
      "promotionPipeline": ".github/workflows/deploy.yml"
    },
    "gitlab": {
      "pipeline": ".gitlab-ci.yml",
      "jobStyle": "gitlab",
      "aggregateJob": "ci-status-summary",
      "releasePipeline": ".gitlab-ci.yml"
    }
  },
  "lanes": {
    "pr": {
      "description": "Evidence for the requirements a change proposal touches.",
      "executors": {
        "github": { "file": ".github/workflows/ci.yml", "job": "spec-evidence" },
        "gitlab": { "file": ".gitlab-ci.yml", "job": "spec-evidence" }
      }
    },
    "main": {
      "description": "Evidence for the requirements a default-branch push touches.",
      "executors": {
        "github": { "file": ".github/workflows/ci.yml", "job": "spec-evidence" },
        "gitlab": { "file": ".gitlab-ci.yml", "job": "spec-evidence" }
      }
    },
    "nightly": {
      "description": "Scheduled full-inventory evidence for every declared requirement.",
      "executors": {
        "github": { "file": ".github/workflows/spec-assurance-nightly.yml", "job": "assurance" },
        "gitlab": { "file": ".gitlab-ci.yml", "job": "spec-evidence-nightly" }
      }
    },
    "runtime": {
      "description": "Evidence that needs a live runtime stack rather than a build sandbox.",
      "executors": {
        "github": { "file": ".github/workflows/spec-assurance-runtime.yml", "job": "assurance" },
        "gitlab": { "file": ".gitlab-ci.yml", "job": "spec-evidence-runtime" }
      }
    },
    "scheduled-quality": {
      "description": "Scheduled cross-browser and mobile visual regression matrix.",
      "executors": {
        "github": { "file": ".github/workflows/quality-presets.yml", "job": "presets" },
        "gitlab": { "file": ".gitlab-ci.yml", "job": "visual-regression-matrix" }
      }
    },
    "release": {
      "description": "Tagged build that publishes signed, scanned, attested images.",
      "executors": {
        "github": { "file": ".github/workflows/release-images.yml", "job": "build-scan-sign" },
        "gitlab": { "file": ".gitlab-ci.yml", "job": "release-images" }
      }
    }
  },
  "gates": [
    {
      "id": "secret-scan-history",
      "description": "Full-history secret scan over the repository.",
      "commands": ["gitleaks/gitleaks-action", "gitleaks detect"],
      "lanes": ["pr", "main"],
      "requiredForMerge": true,
      "jobs": { "github": "gitleaks", "gitlab": "gitleaks" }
    },
    {
      "id": "helm-render",
      "description": "Render the selected Helm deployment for every provider selection.",
      "commands": ["pnpm run deploy:validate:helm"],
      "lanes": ["pr", "main"],
      "requiredForMerge": true,
      "jobs": { "github": "helm-validation", "gitlab": "helm-validation" }
    },
    {
      "id": "ci-pipeline-parity",
      "description": "Every forge renders this gate inventory and no forge silently drops a gate.",
      "commands": ["node scripts/ci/check-pipelines.mjs"],
      "lanes": ["pr", "main"],
      "requiredForMerge": true,
      "jobs": { "github": "helm-validation", "gitlab": "helm-validation" }
    },
    {
      "id": "github-workflow-hardening",
      "description": "Pinned action SHAs, least-privilege permissions, and no pull_request_target.",
      "commands": ["node scripts/validate-github-workflows.mjs"],
      "lanes": ["pr", "main"],
      "requiredForMerge": true,
      "jobs": { "github": "helm-validation" },
      "forges": ["github"],
      "reason": "The checker reads .github/workflows text; a GitLab-only checkout has nothing for it to harden. Its GitLab-contract half is superseded by ci-pipeline-parity."
    },
    {
      "id": "git-conventions",
