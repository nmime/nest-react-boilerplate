import /etc/caddy/common.caddy

(frontend_service) {
	import common_server
	import core_same_origin_api_routes
	import /etc/caddy/routes/optional/{$EDGE_OPTIONAL_ROUTES:default}.caddy
	handle {
		reverse_proxy {args[0]}
	}
	import /etc/caddy/tls/{$EDGE_TLS_MODE:automatic}.caddy
}

(api_service) {
	import common_server
	reverse_proxy {args[0]}
	import /etc/caddy/tls/{$EDGE_TLS_MODE:automatic}.caddy
}

{$LANDING_APP_DOMAIN} {
	import frontend_service landing-app:8080
}

{$SITE_APP_DOMAIN} {
	import frontend_service site-app:80
}

{$USER_APP_DOMAIN} {
	import frontend_service user-app:8080
}

{$ADMIN_APP_DOMAIN} {
	import frontend_service admin-app:8080
}

{$MOBILE_APP_DOMAIN} {
	import frontend_service mobile-app:8080
}

{$AUTH_APP_API_DOMAIN} {
	import api_service auth-app-api:80
}

{$USER_APP_API_DOMAIN} {
	import api_service user-app-api:80
}

{$ADMIN_APP_API_DOMAIN} {
	import api_service admin-app-api:80
}

import /etc/caddy/sites/optional/{$EDGE_OPTIONAL_ROUTES:default}.caddy
