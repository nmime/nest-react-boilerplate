{
  "$schema": "https://json-schema.org/schema",
  "cli": "nx",
  "$id": "@repo/tooling/library",
  "title": "Library",
  "description": "Generate a new library following repository conventions",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Library name (kebab-case)",
      "x-prompt": "What name would you like to give your library?",
      "x-priority": "important"
    },
    "kind": {
      "type": "string",
      "description": "Library kind determines boundary and default tags",
      "enum": ["backend", "frontend", "common"],
      "x-prompt": "What kind of library?",
      "x-priority": "important"
    },
    "directory": {
      "type": "string",
      "description": "Directory path prefix (default: libs/<kind>/<name>)",
      "x-priority": "optional"
    },
    "tags": {
      "type": "string",
      "description": "Comma-separated list of Nx tags (auto-generated by default)",
      "x-priority": "optional"
    },
    "skipFormat": {
      "type": "boolean",
      "description": "Skip formatting the changed files",
      "default": false,
      "x-priority": "optional"
    }
  },
  "required": ["name", "kind"]
}
