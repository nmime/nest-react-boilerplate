# Start from .env.production.example so every runtime setting remains available,
# then set at least the host-proxy contract below. Keep this file root-readable.
PUBLIC_DOMAIN=example.com
PRIMARY_APP=landing-app
# Database engine and ownership are independent. Bundled MongoDB is a
# transaction-capable one-node replica set, not a highly available database.
DATABASE_ENGINE=postgres
COMPOSE_DATABASE_MODE=bundled-db
COMPOSE_DOMAIN_MODE=external-proxy
COMPOSE_TLS_MODE=external
EXTERNAL_PROXY_PUBLIC_MODE=per-app-domains
COMPOSE_PROFILES=

# Configuration-only secret paths. The controller creates only the files for
# the selected engine/ownership pair and never writes secret values here.
POSTGRES_PASSWORD_FILE=./secrets/postgres_password.txt
DATABASE_URL_FILE=./secrets/database_url.txt
MONGODB_ROOT_PASSWORD_FILE=./secrets/mongodb_root_password.txt
MONGODB_PASSWORD_FILE=./secrets/mongodb_password.txt
MONGODB_MIGRATION_PASSWORD_FILE=./secrets/mongodb_migration_password.txt
MONGODB_BACKUP_RESTORE_PASSWORD_FILE=./secrets/mongodb_backup_restore_password.txt
MONGODB_KEYFILE_FILE=./secrets/mongodb_keyfile.txt
MONGODB_URI_FILE=./secrets/mongodb_uri.txt
MONGODB_MIGRATION_URI_FILE=./secrets/mongodb_migration_uri.txt
MONGODB_BACKUP_RESTORE_URI_FILE=./secrets/mongodb_backup_restore_uri.txt
MONGODB_USER=nest_react_boilerplate
MONGODB_MIGRATION_USER=nest_react_boilerplate_migration
MONGODB_BACKUP_RESTORE_USER=nrb_backup_restore
MONGODB_DATABASE=nest_react_boilerplate
MONGODB_REPLICA_SET=rs0
MONGODB_DATABASE_TOOLS_DOCKER_NETWORK=

# Publish immutable CI-built images only. Never use latest.
IMAGE_REGISTRY=ghcr.io/your-github-org/nest-react-boilerplate
IMAGE_TAG=sha-000000000000
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=5

# Browser builds and the host proxy both use same-origin API routing.
VITE_API_BASE_URL_MODE=same-origin
VITE_AUTH_API_BASE_URL=
VITE_USER_API_BASE_URL=
VITE_ADMIN_API_BASE_URL=

# Copy all remaining values from .env.production.example, create every enabled
# *_FILE secret, and never place actual credentials in a tracked file.
