{
  "name": "@app/frontend-api-client",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/frontend/api-client/lib/src",
  "projectType": "library",
  "tags": ["platform:frontend", "type:sdk", "scope:shared", "fsd:layer:shared"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "libs/frontend/api-client/lib",
        "command": "node ../../../../node_modules/typescript/bin/tsc --noEmit --project tsconfig.lib.json"
      },
      "outputs": []
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "libs/frontend/api-client/lib",
        "command": "vitest run --mode development --config vitest.config.mts",
        "env": {
          "NODE_ENV": "development"
        }
      },
      "inputs": [
        "default",
        "^production",
        {
          "externalDependencies": ["vitest"]
        }
      ],
      "outputs": ["{workspaceRoot}/coverage/libs/frontend/api-client"]
    }
  }
}
