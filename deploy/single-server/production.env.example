# Start from .env.production.example so every runtime setting remains available,
# then set at least the host-proxy contract below. Keep this file root-readable.
PUBLIC_DOMAIN=example.com
PRIMARY_APP=landing-app
COMPOSE_DATABASE_MODE=bundled-db
COMPOSE_DOMAIN_MODE=external-proxy
COMPOSE_TLS_MODE=external
EXTERNAL_PROXY_PUBLIC_MODE=per-app-domains
COMPOSE_PROFILES=

# Publish immutable CI-built images only. Never use latest.
IMAGE_REGISTRY=ghcr.io/your-github-org/nest-react-boilerplate
IMAGE_TAG=sha-000000000000
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=5

# Browser builds and the host proxy both use same-origin API routing.
VITE_API_BASE_URL_MODE=same-origin

# Copy all remaining values from .env.production.example, create every enabled
# *_FILE secret, and never place actual credentials in a tracked file.
