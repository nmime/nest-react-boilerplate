{
  "$schema": "https://json-schema.org/schema",
  "cli": "nx",
  "$id": "@repo/tooling/setup",
  "title": "Setup",
  "description": "Configure boilerplate setup with presets and capabilities",
  "type": "object",
  "properties": {
    "preset": {
      "type": "string",
      "description": "Preset configuration to apply",
      "enum": ["minimal", "starter", "fullstack", "enterprise", "bots"],
      "x-priority": "important"
    },
    "apps": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "admin-app",
          "user-app",
          "landing-app",
          "site-app",
          "mobile-app",
          "admin-app-api",
          "user-app-api",
          "auth-app-api",
          "discord-app-api",
          "telegram-bot-api",
          "telegram-bot-worker",
          "fullstack-e2e"
        ]
      },
      "description": "Explicit list of app IDs to enable (overrides preset defaults)",
      "default": [],
      "x-priority": "important"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "i18n",
          "analytics",
          "websockets",
          "feature-flags",
          "notifications",
          "design-tokens",
          "authz",
          "postgres",
          "redis",
          "s3",
          "nats",
          "otel",
          "swagger",
          "telegram-bot",
          "discord-bot"
        ]
      },
      "description": "Explicit list of capability IDs to enable",
      "default": [],
      "x-priority": "important"
    },
    "prune": {
      "type": "boolean",
      "description": "Remove files no longer needed after config change",
      "default": false
    },
    "force": {
      "type": "boolean",
      "description": "Force overwrite generated files without conflict check",
      "default": false
    },
    "dryRun": {
      "type": "boolean",
      "description": "Output the plan as JSON instead of executing",
      "default": false
    }
  },
  "required": []
}
