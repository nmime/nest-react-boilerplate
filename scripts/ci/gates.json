  "supplyChain": [
    {
      "id": "affected-image-plan",
      "requirement": "The images built are selected by the shared plan from the installed product closure, not enumerated per forge.",
      "scope": "release",
      "evidence": ["scripts/release-image-plan.mjs", "generate-bake-file.mjs --only"]
    },
    {
      "id": "bake-only-build",
      "requirement": "Images are produced only by the generated Bake plan, so every image shares one build definition.",
      "scope": "release",
      "evidence": ["docker buildx bake -f docker-bake.json"]
    },
    {
      "id": "build-attestations",
      "requirement": "Every image carries max-mode BuildKit provenance and an SBOM attestation.",
      "scope": "release",
      "evidence": ["*.attest=type=provenance,mode=max", "*.attest=type=sbom"]
    },
    {
      "id": "immutable-digest",
      "requirement": "Post-build steps address images by the digest the build reported, never by a mutable tag.",
      "scope": "release",
      "evidence": ["bake-metadata.json", "^sha256:[0-9a-f]{64}$"]
    },
    {
      "id": "sbom-generation",
      "requirement": "An SPDX SBOM is generated for every published digest.",
      "scope": "release",
      "evidence": ["syft \"$ref\"", "spdx-json=sboms/sbom-"]
    },
    {
      "id": "vulnerability-gate",
      "requirement": "A CRITICAL or HIGH finding fails the release rather than warning.",
      "scope": "release",
      "evidence": ["trivy image --format sarif", "--severity CRITICAL,HIGH", "--exit-code 1"]
    },
    {
      "id": "keyless-signature",
      "requirement": "Every published digest is signed with keyless cosign against the forge OIDC identity.",
      "scope": "release",
      "evidence": ["cosign sign --yes \"$ref\""]
    },
    {
      "id": "sbom-attestation",
      "requirement": "The SBOM is attached to the digest as a verifiable SPDX attestation.",
      "scope": "release",
      "evidence": ["cosign attest --yes --type spdxjson"]
    },
    {
      "id": "provenance-attestation",
      "requirement": "SLSA provenance naming the exact source commit is attached to the digest.",
      "scope": "release",
      "evidence": ["cosign attest --yes --type slsaprovenance1", "resolvedDependencies"]
    },
    {
      "id": "scan-attestation",
      "requirement": "The scan result and its severity policy are attached to the digest.",
      "scope": "release",
      "evidence": [
        "cosign attest --yes --type \"$SCAN_PREDICATE_TYPE\"",
        "severities: [\"CRITICAL\", \"HIGH\"]",
        "allowUnfixed: false"
      ]
    },
    {
      "id": "promotion-full-sha",
      "requirement": "Promotion accepts only a full 40-character source SHA.",
      "scope": "promotion",
      "evidence": ["^[0-9a-f]{40}$"],
      "forges": ["github"],
      "reason": "Only GitHub ships a GitOps promotion pipeline; a GitLab promotion lane is still to be written."
    },
    {
      "id": "promotion-verifies-attestations",
      "requirement": "Promotion verifies the signature, provenance, SBOM, and scan attestation of the digest it deploys.",
      "scope": "promotion",
      "evidence": [
        "cosign verify-attestation --type slsaprovenance1",
        "cosign verify-attestation --type spdxjson",
        "cosign verify-attestation --type \"$SCAN_PREDICATE_TYPE\""
      ],
      "forges": ["github"],
      "reason": "Only GitHub ships a GitOps promotion pipeline; a GitLab promotion lane is still to be written."
    }
  ]
}
